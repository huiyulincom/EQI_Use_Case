# =========================================================
# 23. Overall SCREEN-level overrepresentation
#
# This combines all CSR categories together.
#
# Baseline:
# population distribution of all CSR-matched EQI blocks.
#
# Question:
# Are total CSR cases disproportionately concentrated
# in certain EQI SCREEN groups compared with population?
# =========================================================

output_08_overall_screen_overrep <- file.path(
  output_folder,
  "08_overall_screen_overrepresentation.csv"
)

overall_screen_observed <- matched_df %>%
  count(
    SCREEN,
    name = "overall_observed_case_count"
  ) %>%
  mutate(
    overall_total_observed_cases =
      sum(overall_observed_case_count, na.rm = TRUE),
    
    overall_observed_case_share =
      overall_observed_case_count / overall_total_observed_cases,
    
    overall_observed_case_share_label =
      paste0(round(overall_observed_case_share * 100, 2), "%")
  )

overall_screen_overrepresentation <- overall_screen_observed %>%
  left_join(
    all_csr_population_baseline_by_screen,
    by = "SCREEN"
  ) %>%
  mutate(
    overall_expected_cases_by_population =
      overall_total_observed_cases * all_csr_screen_population_share,
    
    overall_expected_case_share =
      all_csr_screen_population_share,
    
    overall_expected_case_share_label =
      paste0(round(overall_expected_case_share * 100, 2), "%"),
    
    overall_observed_expected_ratio =
      if_else(
        overall_expected_cases_by_population > 0,
        overall_observed_case_count / overall_expected_cases_by_population,
        NA_real_
      ),
    
    overall_excess_cases =
      overall_observed_case_count - overall_expected_cases_by_population,
    
    overall_expected_cases_by_population_round =
      round(overall_expected_cases_by_population, 2),
    
    overall_excess_cases_round =
      round(overall_excess_cases, 2),
    
    overall_observed_expected_ratio_round =
      round(overall_observed_expected_ratio, 2),
    
    overall_representation_level =
      get_representation_level(
        overall_observed_expected_ratio,
        overall_observed_case_count
      )
  ) %>%
  arrange(
    desc(overall_observed_expected_ratio),
    desc(overall_observed_case_count)
  )

safe_write_csv(
  overall_screen_overrepresentation,
  output_08_overall_screen_overrep
)


# =========================================================
# 24. Figure 7:
# Overall SCREEN-level observed-to-expected ratio
# =========================================================

overall_overrep_plot_df <- overall_screen_overrepresentation %>%
  mutate(
    SCREEN = factor(
      SCREEN,
      levels = overall_screen_overrepresentation %>%
        arrange(overall_observed_expected_ratio) %>%
        pull(SCREEN)
    ),
    
    overall_representation_level = factor(
      overall_representation_level,
      levels = c(
        "Below expected",
        "Close to expected",
        "Moderately elevated",
        "Elevated",
        "Strongly elevated",
        "Low case count",
        "No denominator",
        "Unclassified"
      )
    ),
    
    ratio_label = if_else(
      is.na(overall_observed_expected_ratio_round),
      "",
      sprintf("%.2f", overall_observed_expected_ratio_round)
    )
  )

p_overall_overrep_ratio <- ggplot(
  overall_overrep_plot_df,
  aes(
    x = overall_observed_expected_ratio_round,
    y = SCREEN,
    fill = overall_representation_level
  )
) +
  geom_col(width = 0.7) +
  geom_vline(
    xintercept = 1,
    linetype = "solid",
    linewidth = 0.7
  ) +
  geom_vline(
    xintercept = 1.25,
    linetype = "dashed",
    linewidth = 0.6
  ) +
  geom_vline(
    xintercept = 1.5,
    linetype = "dashed",
    linewidth = 0.6
  ) +
  geom_vline(
    xintercept = 2,
    linetype = "dashed",
    linewidth = 0.6
  ) +
  geom_text(
    aes(label = ratio_label),
    hjust = -0.15,
    size = 3.2
  ) +
  scale_fill_manual(
    values = c(
      "Below expected" = "#2C7BB6",
      "Close to expected" = "#D9D9D9",
      "Moderately elevated" = "#FFFFBF",
      "Elevated" = "#FDAE61",
      "Strongly elevated" = "#D7191C",
      "Low case count" = "#F0F0F0",
      "No denominator" = "#BDBDBD",
      "Unclassified" = "white"
    ),
    drop = FALSE
  ) +
  labs(
    title = "Overall CSR Overrepresentation by EQI SCREEN",
    subtitle = "Observed-to-expected ratio compares total CSR cases with the population distribution of all CSR-matched EQI blocks.",
    x = "Observed-to-expected ratio",
    y = "EQI SCREEN",
    fill = "Representation level"
  ) +
  theme_minimal() +
  theme(
    panel.grid.major.y = element_blank(),
    legend.position = "bottom"
  ) +
  coord_cartesian(
    xlim = c(
      0,
      max(overall_overrep_plot_df$overall_observed_expected_ratio_round, na.rm = TRUE) * 1.15
    )
  )

ggsave(
  filename = file.path(
    figure_folder,
    "fig_07_overall_screen_overrepresentation_ratio.png"
  ),
  plot = p_overall_overrep_ratio,
  width = 11,
  height = 7,
  dpi = 300
)


# =========================================================
# 25. Figure 8:
# Overall observed CSR share vs expected population share
# =========================================================

overall_share_plot_df <- overall_screen_overrepresentation %>%
  select(
    SCREEN,
    overall_observed_case_share,
    overall_expected_case_share
  ) %>%
  pivot_longer(
    cols = c(
      overall_observed_case_share,
      overall_expected_case_share
    ),
    names_to = "share_type",
    values_to = "share"
  ) %>%
  mutate(
    share_percent = share * 100,
    
    share_type = case_when(
      share_type == "overall_observed_case_share" ~ "Observed CSR share",
      share_type == "overall_expected_case_share" ~ "Expected population share",
      TRUE ~ share_type
    ),
    
    share_type = factor(
      share_type,
      levels = c(
        "Observed CSR share",
        "Expected population share"
      )
    ),
    
    SCREEN = factor(
      SCREEN,
      levels = overall_screen_overrepresentation %>%
        arrange(overall_observed_expected_ratio) %>%
        pull(SCREEN)
    )
  )

p_overall_share_compare <- ggplot(
  overall_share_plot_df,
  aes(
    x = share_percent,
    y = SCREEN,
    fill = share_type
  )
) +
  geom_col(
    position = position_dodge(width = 0.75),
    width = 0.7
  ) +
  labs(
    title = "Overall CSR Share Compared with Population Baseline by EQI SCREEN",
    subtitle = "Observed CSR share is compared with the expected share based on population in all CSR-matched EQI blocks.",
    x = "Share (%)",
    y = "EQI SCREEN",
    fill = "Metric"
  ) +
  theme_minimal() +
  theme(
    panel.grid.major.y = element_blank(),
    legend.position = "bottom"
  )

ggsave(
  filename = file.path(
    figure_folder,
    "fig_08_overall_screen_observed_vs_expected_share.png"
  ),
  plot = p_overall_share_compare,
  width = 11,
  height = 7,
  dpi = 300
)
