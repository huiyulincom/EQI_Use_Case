# =========================================================
# 23. Fig 04A and Fig 04B:
# Split delay charts with Fig05-style colors
#
# Fig 04A:
# Response median days by CSR category x EQI SCREEN
#
# Fig 04B:
# Resolution median days by CSR category x EQI SCREEN
#
# Bars = SCREEN-specific median days
#
# Color logic uses overall median as the baseline:
# Blue   = at or below baseline
# Gray   = close to baseline
# Yellow = moderately above baseline
# Orange = above baseline
# Red    = strongly above baseline
#
# Reference lines:
# solid  = overall average
# dashed = overall median
# =========================================================

category_screen_delay_chart_data <- category_screen_chart_data %>%
  filter(
    observed_case_count >= min_case_count
  ) %>%
  select(
    Customer_Service_Requested,
    SCREEN,
    category_screen_label,
    
    observed_case_count,
    total_cases_in_category,
    priority_review_group,
    priority_rank,
    
    population_representation_level,
    observed_expected_ratio_by_all_csr_population_round,
    
    response_time_valid_n,
    response_days_average_round,
    response_days_median_round,
    
    resolution_time_valid_n,
    resolution_days_average_round,
    resolution_days_median_round,
    
    response_average_ratio_vs_category_round,
    response_median_ratio_vs_category_round,
    
    resolution_average_ratio_vs_category_round,
    resolution_median_ratio_vs_category_round,
    resolution_median_delay_level,
    
    sort_resolution_ratio,
    sort_overrep_ratio
  )

safe_write_csv(
  category_screen_delay_chart_data,
  output_08_category_screen_delay_chart_data
)


# ---------------------------------------------------------
# Overall baseline values
# ---------------------------------------------------------

overall_response_average <- overall_delay_summary$response_days_average_round[1]
overall_response_median  <- overall_delay_summary$response_days_median_round[1]

overall_resolution_average <- overall_delay_summary$resolution_days_average_round[1]
overall_resolution_median  <- overall_delay_summary$resolution_days_median_round[1]


# =========================================================
# Fig 04A: Response median days
# =========================================================

response_chart_data <- category_screen_delay_chart_data %>%
  filter(
    !is.na(response_days_median_round)
  ) %>%
  mutate(
    response_delay_level_for_plot = case_when(
      is.na(response_days_median_round) ~ "Other / missing",
      
      !is.na(overall_response_median) &
        overall_response_median > 0 &
        response_days_median_round <= overall_response_median ~
        "At or below baseline",
      
      !is.na(overall_response_median) &
        overall_response_median > 0 &
        response_days_median_round <= overall_response_median * 1.25 ~
        "Close to baseline",
      
      !is.na(overall_response_median) &
        overall_response_median > 0 &
        response_days_median_round <= overall_response_median * 1.50 ~
        "Moderately above baseline",
      
      !is.na(overall_response_median) &
        overall_response_median > 0 &
        response_days_median_round <= overall_response_median * 2.00 ~
        "Above baseline",
      
      !is.na(overall_response_median) &
        overall_response_median > 0 &
        response_days_median_round > overall_response_median * 2.00 ~
        "Strongly above baseline",
      
      TRUE ~ "Other / missing"
    ),
    
    response_delay_level_for_plot = factor(
      response_delay_level_for_plot,
      levels = c(
        "At or below baseline",
        "Close to baseline",
        "Moderately above baseline",
        "Above baseline",
        "Strongly above baseline",
        "Other / missing"
      )
    ),
    
    sort_response_median_days = if_else(
      is.na(response_days_median_round),
      -Inf,
      response_days_median_round
    )
  ) %>%
  arrange(
    desc(sort_response_median_days),
    desc(sort_overrep_ratio),
    desc(observed_case_count)
  ) %>%
  slice_head(n = top_n_category_screen_for_delay_bar)

response_chart_data <- response_chart_data %>%
  mutate(
    category_screen_label = factor(
      category_screen_label,
      levels = rev(unique(category_screen_label))
    ),
    
    response_label = sprintf("%.2f", response_days_median_round)
  )

response_baseline_line_df <- tibble::tibble(
  baseline_value = c(
    overall_response_average,
    overall_response_median
  ),
  
  baseline_label = c(
    "Overall response average",
    "Overall response median"
  )
) %>%
  filter(!is.na(baseline_value)) %>%
  mutate(
    baseline_label = factor(
      baseline_label,
      levels = c(
        "Overall response average",
        "Overall response median"
      )
    )
  )

response_chart_height <- max(
  12,
  length(unique(response_chart_data$category_screen_label)) * 0.30
)

p_response_median_days <- ggplot(
  response_chart_data,
  aes(
    x = response_days_median_round,
    y = category_screen_label,
    fill = response_delay_level_for_plot
  )
) +
  geom_col(width = 0.7) +
  geom_vline(
    data = response_baseline_line_df,
    aes(
      xintercept = baseline_value,
      linetype = baseline_label
    ),
    linewidth = 0.8,
    inherit.aes = FALSE
  ) +
  geom_text(
    aes(label = response_label),
    hjust = -0.15,
    size = 3
  ) +
  scale_fill_manual(
    values = c(
      "At or below baseline" = "#2C7BB6",
      "Close to baseline" = "#D9D9D9",
      "Moderately above baseline" = "#FFFFBF",
      "Above baseline" = "#FDAE61",
      "Strongly above baseline" = "#D7191C",
      "Other / missing" = "white"
    ),
    drop = FALSE
  ) +
  scale_linetype_manual(
    values = c(
      "Overall response average" = "solid",
      "Overall response median" = "dashed"
    ),
    drop = FALSE
  ) +
  labs(
    title = "Response Median Days by CSR Category x EQI SCREEN",
    subtitle = "Sorted by SCREEN-specific median response days. Colors compare each value with the overall response median baseline.",
    x = "Median response days",
    y = "CSR Category x EQI SCREEN",
    fill = "Response delay level",
    linetype = "Overall baseline"
  ) +
  theme_minimal() +
  theme(
    panel.grid.major.y = element_blank(),
    legend.position = "bottom"
  ) +
  guides(
    fill = guide_legend(order = 1),
    linetype = guide_legend(order = 2)
  ) +
  coord_cartesian(
    xlim = c(
      0,
      max(response_chart_data$response_days_median_round, na.rm = TRUE) * 1.15
    )
  )

fig04a_path <- file.path(
  figure_folder,
  "fig_04a_category_screen_response_median_days_with_overall_baseline_sorted.png"
)

ggsave(
  filename = fig04a_path,
  plot = p_response_median_days,
  width = 15,
  height = response_chart_height,
  dpi = 300
)

cat("Wrote Fig 04A:", fig04a_path, "\n")
cat("Fig 04A exists:", file.exists(fig04a_path), "\n")


