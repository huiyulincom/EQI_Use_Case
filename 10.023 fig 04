# =========================================================
# 23. Fig 04:
# Category x SCREEN resolution delay ratio chart
#
# Bar = resolution median ratio vs category
#
# Definition:
# SCREEN-specific median resolution days /
# category-wide median resolution days
#
# This chart is sorted the same way as Fig 05:
# priority group first,
# then overrepresentation ratio,
# then resolution delay ratio,
# then observed case count.
# =========================================================

category_screen_resolution_ratio_chart_data <- category_screen_chart_data %>%
  filter(
    observed_case_count >= min_case_count,
    !is.na(resolution_median_ratio_vs_category_round)
  ) %>%
  mutate(
    resolution_level_for_plot = case_when(
      resolution_median_delay_level == "Faster than category typical" ~ "Faster than category typical",
      resolution_median_delay_level == "Similar to category typical" ~ "Similar to category typical",
      resolution_median_delay_level == "Moderately slower" ~ "Moderately slower",
      resolution_median_delay_level == "Slower" ~ "Slower",
      resolution_median_delay_level == "Much slower" ~ "Much slower",
      resolution_median_delay_level == "Low valid time count" ~ "Low valid time count",
      resolution_median_delay_level == "No valid category baseline" ~ "No valid category baseline",
      TRUE ~ "Other / missing"
    ),
    
    resolution_level_for_plot = factor(
      resolution_level_for_plot,
      levels = c(
        "Faster than category typical",
        "Similar to category typical",
        "Moderately slower",
        "Slower",
        "Much slower",
        "Low valid time count",
        "No valid category baseline",
        "Other / missing"
      )
    )
  ) %>%
  select(
    Customer_Service_Requested,
    SCREEN,
    category_screen_label,
    
    observed_case_count,
    total_cases_in_category,
    priority_review_group,
    priority_rank,
    
    population_representation_level,
    observed_expected_ratio_by_all_csr_population_round,
    
    resolution_days_median_round,
    category_resolution_days_median_round,
    resolution_median_ratio_vs_category_round,
    resolution_median_delay_level,
    resolution_level_for_plot,
    
    sort_overrep_ratio,
    sort_resolution_ratio
  ) %>%
  arrange(
    priority_rank,
    desc(sort_overrep_ratio),
    desc(sort_resolution_ratio),
    desc(observed_case_count)
  ) %>%
  slice_head(n = top_n_category_screen_for_delay_bar)

# Save Fig 04 chart data
safe_write_csv(
  category_screen_resolution_ratio_chart_data,
  output_08_category_screen_delay_chart_data
)

# Reverse levels so highest priority rows show at the top
resolution_ratio_category_screen_order <- rev(
  category_screen_resolution_ratio_chart_data$category_screen_label
)

category_screen_resolution_ratio_chart_data <- category_screen_resolution_ratio_chart_data %>%
  mutate(
    category_screen_label = factor(
      category_screen_label,
      levels = resolution_ratio_category_screen_order
    ),
    
    ratio_label = if_else(
      is.na(resolution_median_ratio_vs_category_round),
      "",
      sprintf("%.2f", resolution_median_ratio_vs_category_round)
    )
  )

resolution_ratio_chart_height <- max(
  12,
  length(unique(category_screen_resolution_ratio_chart_data$category_screen_label)) * 0.30
)

p_category_screen_resolution_ratio <- ggplot(
  category_screen_resolution_ratio_chart_data,
  aes(
    x = resolution_median_ratio_vs_category_round,
    y = category_screen_label,
    fill = resolution_level_for_plot
  )
) +
  geom_col(width = 0.7) +
  geom_vline(
    xintercept = 1,
    linetype = "solid",
    linewidth = 0.7
  ) +
  geom_vline(
    xintercept = 1.25,
    linetype = "dashed",
    linewidth = 0.6
  ) +
  geom_vline(
    xintercept = 1.5,
    linetype = "dashed",
    linewidth = 0.6
  ) +
  geom_vline(
    xintercept = 2,
    linetype = "dashed",
    linewidth = 0.6
  ) +
  geom_text(
    aes(label = ratio_label),
    hjust = -0.15,
    size = 3
  ) +
  scale_fill_manual(
    values = c(
      "Faster than category typical" = "#2C7BB6",
      "Similar to category typical" = "#D9D9D9",
      "Moderately slower" = "#FFFFBF",
      "Slower" = "#FDAE61",
      "Much slower" = "#D7191C",
      "Low valid time count" = "#F0F0F0",
      "No valid category baseline" = "#BDBDBD",
      "Other / missing" = "white"
    ),
    drop = FALSE
  ) +
  labs(
    title = "Resolution Delay Ratio by CSR Category x EQI SCREEN",
    subtitle = "Bar shows SCREEN-specific median resolution time divided by category-wide median resolution time.",
    x = "Median resolution ratio vs category",
    y = "CSR Category x EQI SCREEN",
    fill = "Resolution delay level"
  ) +
  theme_minimal() +
  theme(
    panel.grid.major.y = element_blank(),
    legend.position = "bottom"
  ) +
  coord_cartesian(
    xlim = c(
      0,
      max(
        category_screen_resolution_ratio_chart_data$resolution_median_ratio_vs_category_round,
        na.rm = TRUE
      ) * 1.15
    )
  )

ggsave(
  filename = file.path(
    figure_folder,
    "fig_04_category_screen_resolution_delay_ratio_sorted.png"
  ),
  plot = p_category_screen_resolution_ratio,
  width = 15,
  height = resolution_ratio_chart_height,
  dpi = 300
)
