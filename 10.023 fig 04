# =========================================================
# 23. Fig 04:
# Category x SCREEN delay days chart with OVERALL baseline
#
# Row = CSR category x EQI SCREEN
# Bars = SCREEN-specific average / median days
#
# Sorting:
# Highest SCREEN-specific median resolution days first.
#
# Reference lines:
# Response panel:
#   overall response average
#   overall response median
#
# Resolution panel:
#   overall resolution average
#   overall resolution median
# =========================================================

category_screen_delay_chart_data <- category_screen_chart_data %>%
  filter(
    observed_case_count >= min_case_count
  ) %>%
  select(
    Customer_Service_Requested,
    SCREEN,
    category_screen_label,
    observed_case_count,
    total_cases_in_category,
    priority_review_group,
    priority_rank,
    population_representation_level,
    observed_expected_ratio_by_all_csr_population_round,
    
    response_time_valid_n,
    response_days_average_round,
    response_days_median_round,
    
    resolution_time_valid_n,
    resolution_days_average_round,
    resolution_days_median_round,
    
    response_average_ratio_vs_category_round,
    response_median_ratio_vs_category_round,
    
    resolution_average_ratio_vs_category_round,
    resolution_median_ratio_vs_category_round,
    resolution_median_delay_level,
    
    sort_resolution_ratio,
    sort_overrep_ratio
  ) %>%
  mutate(
    sort_resolution_median_days = if_else(
      is.na(resolution_days_median_round),
      -Inf,
      resolution_days_median_round
    ),
    
    sort_resolution_average_days = if_else(
      is.na(resolution_days_average_round),
      -Inf,
      resolution_days_average_round
    ),
    
    sort_response_median_days = if_else(
      is.na(response_days_median_round),
      -Inf,
      response_days_median_round
    )
  ) %>%
  arrange(
    desc(sort_resolution_median_days),
    desc(sort_resolution_average_days),
    desc(sort_response_median_days),
    desc(sort_overrep_ratio),
    desc(observed_case_count)
  ) %>%
  slice_head(n = top_n_category_screen_for_delay_bar)

safe_write_csv(
  category_screen_delay_chart_data,
  output_08_category_screen_delay_chart_data
)

# IMPORTANT:
# For horizontal bar charts, factor levels appear from bottom to top.
# We reverse the sorted order so the highest values appear at the top.
category_screen_label_order <- rev(
  unique(category_screen_delay_chart_data$category_screen_label)
)

category_screen_delay_chart_data <- category_screen_delay_chart_data %>%
  mutate(
    category_screen_label = factor(
      category_screen_label,
      levels = category_screen_label_order
    )
  )

screen_delay_long <- category_screen_delay_chart_data %>%
  select(
    category_screen_label,
    Customer_Service_Requested,
    SCREEN,
    observed_case_count,
    
    response_days_average_round,
    response_days_median_round,
    resolution_days_average_round,
    resolution_days_median_round
  ) %>%
  pivot_longer(
    cols = c(
      response_days_average_round,
      response_days_median_round,
      resolution_days_average_round,
      resolution_days_median_round
    ),
    names_to = "metric",
    values_to = "days"
  ) %>%
  mutate(
    time_type = case_when(
      metric %in% c(
        "response_days_average_round",
        "response_days_median_round"
      ) ~ "Response",
      
      metric %in% c(
        "resolution_days_average_round",
        "resolution_days_median_round"
      ) ~ "Resolution",
      
      TRUE ~ "Other"
    ),
    
    statistic = case_when(
      metric %in% c(
        "response_days_average_round",
        "resolution_days_average_round"
      ) ~ "SCREEN average",
      
      metric %in% c(
        "response_days_median_round",
        "resolution_days_median_round"
      ) ~ "SCREEN median",
      
      TRUE ~ metric
    ),
    
    time_type = factor(
      time_type,
      levels = c("Response", "Resolution")
    ),
    
    statistic = factor(
      statistic,
      levels = c(
        "SCREEN average",
        "SCREEN median"
      )
    )
  ) %>%
  filter(!is.na(days))


# ---------------------------------------------------------
# Overall baseline values
# ---------------------------------------------------------

overall_response_average <- overall_delay_summary$response_days_average_round[1]
overall_response_median  <- overall_delay_summary$response_days_median_round[1]

overall_resolution_average <- overall_delay_summary$resolution_days_average_round[1]
overall_resolution_median  <- overall_delay_summary$resolution_days_median_round[1]

overall_baseline_line_df <- tibble::tibble(
  time_type = c(
    "Response",
    "Response",
    "Resolution",
    "Resolution"
  ),
  
  overall_metric = c(
    "Overall average",
    "Overall median",
    "Overall average",
    "Overall median"
  ),
  
  overall_days = c(
    overall_response_average,
    overall_response_median,
    overall_resolution_average,
    overall_resolution_median
  )
) %>%
  mutate(
    time_type = factor(
      time_type,
      levels = c("Response", "Resolution")
    ),
    
    overall_metric = factor(
      overall_metric,
      levels = c(
        "Overall average",
        "Overall median"
      )
    )
  ) %>%
  filter(!is.na(overall_days))


# ---------------------------------------------------------
# Draw Fig 04
# ---------------------------------------------------------

category_screen_delay_chart_height <- max(
  12,
  length(unique(screen_delay_long$category_screen_label)) * 0.30
)

p_category_screen_delay_overall_baseline <- ggplot(
  screen_delay_long,
  aes(
    x = days,
    y = category_screen_label,
    fill = statistic
  )
) +
  geom_col(
    position = position_dodge(width = 0.75),
    width = 0.7
  ) +
  geom_vline(
    data = overall_baseline_line_df,
    aes(
      xintercept = overall_days,
      linetype = overall_metric
    ),
    linewidth = 0.8,
    inherit.aes = FALSE
  ) +
  scale_fill_manual(
    values = c(
      "SCREEN average" = "#FDAE61",
      "SCREEN median" = "#2C7BB6"
    ),
    drop = FALSE
  ) +
  scale_linetype_manual(
    values = c(
      "Overall average" = "solid",
      "Overall median" = "dashed"
    ),
    drop = FALSE
  ) +
  facet_wrap(
    ~ time_type,
    scales = "free_x"
  ) +
  labs(
    title = "Response and Resolution Days by CSR Category x EQI SCREEN",
    subtitle = "Sorted by SCREEN-specific median resolution days. Bars show category x SCREEN values; vertical lines show overall CSR average and median baselines.",
    x = "Days",
    y = "CSR Category x EQI SCREEN",
    fill = "SCREEN metric",
    linetype = "Overall baseline"
  ) +
  theme_minimal() +
  theme(
    panel.grid.major.y = element_blank(),
    legend.position = "bottom"
  ) +
  guides(
    fill = guide_legend(order = 1),
    linetype = guide_legend(order = 2)
  )

fig04_path <- file.path(
  figure_folder,
  "fig_04_category_screen_delay_all_metrics_with_overall_baseline_sorted.png"
)

ggsave(
  filename = fig04_path,
  plot = p_category_screen_delay_overall_baseline,
  width = 15,
  height = category_screen_delay_chart_height,
  dpi = 300
)

cat("Wrote Fig 04:", fig04_path, "\n")
cat("Fig 04 exists:", file.exists(fig04_path), "\n")
