library(sf)
library(dplyr)
library(stringr)
library(readr)
library(purrr)
library(tidyr)
library(lubridate)
library(forcats)

# =========================================================
# 1. User inputs
# =========================================================
gdb_path_points <- "C:/Users/s160418/OneDrive - California Department of Transportation/Desktop/ESTA/EQI Use Case/Maintenance/Maintenance_CSR/Maintenance_CSR.gdb"
layer_points    <- "CSR_02_23_2026_Projected"      # contains Customer_Service_Requested

gdb_path_eqi <- "C:/Users/s160418/OneDrive - California Department of Transportation/Desktop/ESTA/EQI Use Case/Maintenance/Maintenance_CSR/Maintenance_CSR.gdb"
layer_eqi    <- "EQI_Shapefile_ExportFeatures"     # contains SCREEN

output_folder <- "C:/Users/s160418/OneDrive - California Department of Transportation/Desktop/ESTA/EQI Use Case/Maintenance/Maintenance_CSR"

output_overall_csv <- file.path(
  output_folder,
  "customer_service_requested_summary.csv"
)

output_csv <- file.path(
  output_folder,
  "customer_service_requested_by_screen_by_pop.csv"
)

# Time pattern outputs
output_time_month_csv <- file.path(
  output_folder,
  "csr_time_pattern_by_month.csv"
)

output_time_dow_csv <- file.path(
  output_folder,
  "csr_time_pattern_by_day_of_week.csv"
)

output_time_hour_csv <- file.path(
  output_folder,
  "csr_time_pattern_by_hour.csv"
)

output_time_category_summary_csv <- file.path(
  output_folder,
  "csr_time_pattern_category_summary.csv"
)

output_time_screen_month_csv <- file.path(
  output_folder,
  "csr_time_pattern_by_screen_month.csv"
)

field_request <- "Customer_Service_Requested"
field_screen  <- "SCREEN"
field_pop     <- "POP20"

# IMPORTANT:
# Change this to the actual time field in your CSR point layer.
field_time <- "Created_Date"

# Optional: if EQI polygon layer already has a stable unique ID field, use it here
eqi_id_field <- NULL
# eqi_id_field <- "OBJECTID"


# =========================================================
# 2. Read data
# =========================================================
points_sf <- st_read(gdb_path_points, layer = layer_points, quiet = FALSE)
eqi_sf    <- st_read(gdb_path_eqi,    layer = layer_eqi,    quiet = FALSE)


# =========================================================
# 3. Check required fields
# =========================================================
if (!(field_request %in% names(points_sf))) {
  stop(
    paste0(
      "Field '", field_request, "' was not found in point layer.\n",
      "Available fields:\n",
      paste(names(points_sf), collapse = ", ")
    )
  )
}

if (!(field_time %in% names(points_sf))) {
  stop(
    paste0(
      "Field '", field_time, "' was not found in point layer.\n",
      "Available fields:\n",
      paste(names(points_sf), collapse = ", ")
    )
  )
}

if (!(field_screen %in% names(eqi_sf))) {
  stop(
    paste0(
      "Field '", field_screen, "' was not found in EQI layer.\n",
      "Available fields:\n",
      paste(names(eqi_sf), collapse = ", ")
    )
  )
}

if (!(field_pop %in% names(eqi_sf))) {
  stop(
    paste0(
      "Field '", field_pop, "' was not found in EQI layer.\n",
      "Available fields:\n",
      paste(names(eqi_sf), collapse = ", ")
    )
  )
}


# =========================================================
# 4. Match CRS
# =========================================================
if (st_crs(points_sf) != st_crs(eqi_sf)) {
  eqi_sf <- st_transform(eqi_sf, st_crs(points_sf))
}


# =========================================================
# 5. Create unique EQI polygon ID
# =========================================================
if (!is.null(eqi_id_field)) {
  if (!(eqi_id_field %in% names(eqi_sf))) {
    stop(
      paste0(
        "eqi_id_field '", eqi_id_field, "' was not found in EQI layer."
      )
    )
  }
  
  eqi_sf <- eqi_sf %>%
    mutate(eqi_poly_id = as.character(.data[[eqi_id_field]]))
  
} else {
  eqi_sf <- eqi_sf %>%
    mutate(eqi_poly_id = as.character(row_number()))
}


# =========================================================
# 6. Clean attributes
# =========================================================

points_clean <- points_sf %>%
  select(all_of(c(field_request, field_time))) %>%
  mutate(
    Customer_Service_Requested = as.character(.data[[field_request]]),
    Customer_Service_Requested = str_squish(Customer_Service_Requested),
    Customer_Service_Requested = na_if(Customer_Service_Requested, ""),
    Customer_Service_Requested = if_else(
      is.na(Customer_Service_Requested),
      "NA / Blank",
      Customer_Service_Requested
    ),
    
    request_time_raw = .data[[field_time]],
    
    # This should work for most ArcGIS datetime fields.
    # If your time field is stored as character in a special format,
    # this may need to be adjusted.
    request_datetime = suppressWarnings(
      as.POSIXct(request_time_raw, tz = "America/Los_Angeles")
    ),
    
    request_date = as.Date(request_datetime),
    request_year = year(request_datetime),
    request_month = floor_date(request_datetime, unit = "month"),
    request_month_label = format(request_month, "%Y-%m"),
    request_quarter = paste0(request_year, "-Q", quarter(request_datetime)),
    request_week = floor_date(request_datetime, unit = "week", week_start = 1),
    request_day_of_week = wday(
      request_datetime,
      label = TRUE,
      abbr = FALSE,
      week_start = 1
    ),
    request_hour = hour(request_datetime),
    is_weekend = if_else(
      as.character(request_day_of_week) %in% c("Saturday", "Sunday"),
      TRUE,
      FALSE
    )
  )

eqi_clean <- eqi_sf %>%
  select(eqi_poly_id, all_of(field_screen), all_of(field_pop)) %>%
  mutate(
    SCREEN = as.character(.data[[field_screen]]),
    SCREEN = str_squish(SCREEN),
    SCREEN = na_if(SCREEN, ""),
    SCREEN = if_else(
      is.na(SCREEN),
      "NA / Blank",
      SCREEN
    ),
    POP20 = suppressWarnings(as.numeric(.data[[field_pop]])),
    POP20 = if_else(is.na(POP20), 0, POP20)
  )


# =========================================================
# 7. Spatial join: assign each point to EQI polygon
# =========================================================
joined_sf <- st_join(points_clean, eqi_clean, left = TRUE)

joined_sf <- joined_sf %>%
  mutate(
    SCREEN = if_else(is.na(SCREEN), "Outside polygon / No match", SCREEN),
    eqi_poly_id = if_else(is.na(eqi_poly_id), "No_match", eqi_poly_id),
    POP20 = if_else(is.na(POP20), 0, POP20)
  )


# =========================================================
# 8. Original by-screen summary:
#    category x SCREEN case counts
# =========================================================
summary_by_screen <- joined_sf %>%
  st_drop_geometry() %>%
  count(Customer_Service_Requested, SCREEN, name = "case_count") %>%
  group_by(Customer_Service_Requested) %>%
  mutate(
    total_cases_in_request_category = sum(case_count),
    percent_of_category = case_count / total_cases_in_request_category,
    percent_label = paste0(round(percent_of_category * 100, 2), "%")
  ) %>%
  ungroup()


# =========================================================
# 9. Correct denominator:
#    For each category x SCREEN, sum POP20 only for the EQI polygons
#    where that category actually appears
# =========================================================

category_screen_polygons <- joined_sf %>%
  st_drop_geometry() %>%
  filter(eqi_poly_id != "No_match") %>%
  distinct(Customer_Service_Requested, SCREEN, eqi_poly_id, POP20)

category_screen_population <- category_screen_polygons %>%
  group_by(Customer_Service_Requested, SCREEN) %>%
  summarise(
    matched_polygon_pop20 = sum(POP20, na.rm = TRUE),
    matched_polygon_count = n(),
    .groups = "drop"
  )


# =========================================================
# 9B. Category Overall Average Rate
# =========================================================

category_total_population <- category_screen_population %>%
  group_by(Customer_Service_Requested) %>%
  summarise(
    category_total_pop20 = sum(matched_polygon_pop20, na.rm = TRUE),
    .groups = "drop"
  )

category_overall_rate <- summary_by_screen %>%
  group_by(Customer_Service_Requested) %>%
  summarise(
    total_cases_in_request_category = first(total_cases_in_request_category),
    .groups = "drop"
  ) %>%
  left_join(
    category_total_population,
    by = "Customer_Service_Requested"
  ) %>%
  mutate(
    category_average_per_1000 = if_else(
      category_total_pop20 > 0,
      total_cases_in_request_category / category_total_pop20 * 1000,
      NA_real_
    )
  )


# =========================================================
# 10. Join corrected denominator and calculate rates
# =========================================================

summary_by_screen <- summary_by_screen %>%
  left_join(
    category_screen_population,
    by = c("Customer_Service_Requested", "SCREEN")
  ) %>%
  mutate(
    matched_polygon_pop20 = coalesce(matched_polygon_pop20, 0),
    matched_polygon_count = coalesce(matched_polygon_count, 0L),
    case_per_person_matched_pop = if_else(
      matched_polygon_pop20 > 0,
      case_count / matched_polygon_pop20,
      NA_real_
    ),
    case_per_1000_matched_pop = if_else(
      matched_polygon_pop20 > 0,
      case_count / matched_polygon_pop20 * 1000,
      NA_real_
    ),
    case_per_100k_matched_pop = if_else(
      matched_polygon_pop20 > 0,
      case_count / matched_polygon_pop20 * 100000,
      NA_real_
    )
  ) %>%
  left_join(
    category_overall_rate %>%
      select(
        Customer_Service_Requested,
        category_average_per_1000
      ),
    by = "Customer_Service_Requested"
  ) %>%
  arrange(Customer_Service_Requested, desc(case_count))


# =========================================================
# 11. Overall category summary
# =========================================================

summary_overall <- joined_sf %>%
  st_drop_geometry() %>%
  count(Customer_Service_Requested, name = "total_cases") %>%
  mutate(
    percent_of_all_cases = total_cases / sum(total_cases),
    percent_label = paste0(round(percent_of_all_cases * 100, 2), "%")
  ) %>%
  arrange(desc(total_cases))


# =========================================================
# 12. Time pattern: category x month
# =========================================================

summary_by_category_month <- joined_sf %>%
  st_drop_geometry() %>%
  filter(!is.na(request_month)) %>%
  count(
    Customer_Service_Requested,
    request_month,
    request_month_label,
    name = "case_count"
  ) %>%
  group_by(Customer_Service_Requested) %>%
  mutate(
    total_cases_in_category = sum(case_count),
    percent_of_category = case_count / total_cases_in_category,
    average_monthly_cases = mean(case_count),
    month_index = case_count / average_monthly_cases,
    percent_label = paste0(round(percent_of_category * 100, 2), "%")
  ) %>%
  ungroup() %>%
  arrange(Customer_Service_Requested, request_month)


# =========================================================
# 13. Time pattern: category x quarter
# =========================================================

summary_by_category_quarter <- joined_sf %>%
  st_drop_geometry() %>%
  filter(!is.na(request_quarter)) %>%
  count(
    Customer_Service_Requested,
    request_quarter,
    name = "case_count"
  ) %>%
  group_by(Customer_Service_Requested) %>%
  mutate(
    total_cases_in_category = sum(case_count),
    percent_of_category = case_count / total_cases_in_category,
    average_quarterly_cases = mean(case_count),
    quarter_index = case_count / average_quarterly_cases,
    percent_label = paste0(round(percent_of_category * 100, 2), "%")
  ) %>%
  ungroup() %>%
  arrange(Customer_Service_Requested, request_quarter)


# =========================================================
# 14. Time pattern: category x day of week
# =========================================================

summary_by_category_dow <- joined_sf %>%
  st_drop_geometry() %>%
  filter(!is.na(request_day_of_week)) %>%
  count(
    Customer_Service_Requested,
    request_day_of_week,
    name = "case_count"
  ) %>%
  group_by(Customer_Service_Requested) %>%
  mutate(
    total_cases_in_category = sum(case_count),
    percent_of_category = case_count / total_cases_in_category,
    average_daily_cases = mean(case_count),
    day_of_week_index = case_count / average_daily_cases,
    percent_label = paste0(round(percent_of_category * 100, 2), "%")
  ) %>%
  ungroup() %>%
  arrange(Customer_Service_Requested, request_day_of_week)


# =========================================================
# 15. Time pattern: category x hour
# =========================================================

summary_by_category_hour <- joined_sf %>%
  st_drop_geometry() %>%
  filter(!is.na(request_hour)) %>%
  count(
    Customer_Service_Requested,
    request_hour,
    name = "case_count"
  ) %>%
  group_by(Customer_Service_Requested) %>%
  mutate(
    total_cases_in_category = sum(case_count),
    percent_of_category = case_count / total_cases_in_category,
    average_hourly_cases = mean(case_count),
    hour_index = case_count / average_hourly_cases,
    percent_label = paste0(round(percent_of_category * 100, 2), "%")
  ) %>%
  ungroup() %>%
  arrange(Customer_Service_Requested, request_hour)


# =========================================================
# 16. Category-level time pattern summary
# =========================================================

category_peak_month <- summary_by_category_month %>%
  group_by(Customer_Service_Requested) %>%
  slice_max(order_by = case_count, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  select(
    Customer_Service_Requested,
    peak_month = request_month_label,
    peak_month_cases = case_count,
    peak_month_index = month_index
  )

category_peak_quarter <- summary_by_category_quarter %>%
  group_by(Customer_Service_Requested) %>%
  slice_max(order_by = case_count, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  select(
    Customer_Service_Requested,
    peak_quarter = request_quarter,
    peak_quarter_cases = case_count,
    peak_quarter_index = quarter_index
  )

category_peak_dow <- summary_by_category_dow %>%
  group_by(Customer_Service_Requested) %>%
  slice_max(order_by = case_count, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  select(
    Customer_Service_Requested,
    peak_day_of_week = request_day_of_week,
    peak_dow_cases = case_count,
    peak_dow_index = day_of_week_index
  )

category_peak_hour <- summary_by_category_hour %>%
  group_by(Customer_Service_Requested) %>%
  slice_max(order_by = case_count, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  select(
    Customer_Service_Requested,
    peak_hour = request_hour,
    peak_hour_cases = case_count,
    peak_hour_index = hour_index
  )

category_weekend_summary <- joined_sf %>%
  st_drop_geometry() %>%
  filter(!is.na(is_weekend)) %>%
  group_by(Customer_Service_Requested) %>%
  summarise(
    total_cases = n(),
    weekday_cases = sum(!is_weekend, na.rm = TRUE),
    weekend_cases = sum(is_weekend, na.rm = TRUE),
    weekday_share = weekday_cases / total_cases,
    weekend_share = weekend_cases / total_cases,
    .groups = "drop"
  )

summary_category_time_pattern <- category_weekend_summary %>%
  left_join(category_peak_month, by = "Customer_Service_Requested") %>%
  left_join(category_peak_quarter, by = "Customer_Service_Requested") %>%
  left_join(category_peak_dow, by = "Customer_Service_Requested") %>%
  left_join(category_peak_hour, by = "Customer_Service_Requested") %>%
  arrange(desc(total_cases))


# =========================================================
# 17. Time pattern: category x SCREEN x month
# =========================================================

summary_by_category_screen_month <- joined_sf %>%
  st_drop_geometry() %>%
  filter(!is.na(request_month)) %>%
  count(
    Customer_Service_Requested,
    SCREEN,
    request_month,
    request_month_label,
    name = "case_count"
  ) %>%
  group_by(Customer_Service_Requested, SCREEN) %>%
  mutate(
    total_cases_in_category_screen = sum(case_count),
    percent_of_category_screen = case_count / total_cases_in_category_screen,
    average_monthly_cases_category_screen = mean(case_count),
    month_index_category_screen =
      case_count / average_monthly_cases_category_screen,
    percent_label = paste0(round(percent_of_category_screen * 100, 2), "%")
  ) %>%
  ungroup() %>%
  arrange(Customer_Service_Requested, SCREEN, request_month)


# =========================================================
# 18. Export CSV
# =========================================================

write_csv(summary_overall, output_overall_csv)
write_csv(summary_by_screen, output_csv)

write_csv(summary_by_category_month, output_time_month_csv)
write_csv(summary_by_category_dow, output_time_dow_csv)
write_csv(summary_by_category_hour, output_time_hour_csv)
write_csv(summary_category_time_pattern, output_time_category_summary_csv)
write_csv(summary_by_category_screen_month, output_time_screen_month_csv)

cat("\nDone.\n")
cat("Main output saved to:\n", output_csv, "\n")
cat("Overall category summary saved to:\n", output_overall_csv, "\n")

cat("\nTime pattern outputs saved to:\n")
cat(output_time_month_csv, "\n")
cat(output_time_dow_csv, "\n")
cat(output_time_hour_csv, "\n")
cat(output_time_category_summary_csv, "\n")
cat(output_time_screen_month_csv, "\n")
