      population_representation_level == "Strongly elevated" ~
        "High priority pattern",
      
      population_representation_level == "Elevated" ~
        "Elevated priority pattern",
      
      population_representation_level == "Moderately elevated" ~
        "Moderate priority pattern",
      
      population_representation_level == "Below expected" ~
        "Below expected",
      
      population_representation_level == "Close to expected" ~
        "Close to expected",
      
      TRUE ~
        "Review"
    ),
    
    interpretation = case_when(
      population_representation_level == "Strongly elevated" ~
        "Observed cases are at least 2 times expected based on the population distribution of all CSR-matched EQI blocks.",
      
      population_representation_level == "Elevated" ~
        "Observed cases are at least 1.5 times expected based on the population distribution of all CSR-matched EQI blocks.",
      
      population_representation_level == "Moderately elevated" ~
        "Observed cases are at least 1.25 times expected based on the population distribution of all CSR-matched EQI blocks.",
      
      population_representation_level == "Below expected" ~
        "Observed cases are lower than expected based on the population distribution of all CSR-matched EQI blocks.",
      
      population_representation_level == "Close to expected" ~
        "Observed cases are close to expected based on the population distribution of all CSR-matched EQI blocks.",
      
      population_representation_level == "Low case count" ~
        "Observed case count is below the minimum threshold; interpret with caution.",
      
      TRUE ~
        "Review denominator and case count."
    )
  ) %>%
  select(
    Customer_Service_Requested,
    SCREEN,
    
    observed_case_count,
    total_cases_in_category,
    observed_case_share_within_category,
    observed_case_share_within_category_label,
    
    all_csr_screen_block_count,
    all_csr_total_matched_block_count,
    
    all_csr_screen_population,
    all_csr_total_population,
    all_csr_screen_population_share,
    all_csr_screen_population_share_label,
    
    expected_cases_by_all_csr_population,
    expected_cases_by_all_csr_population_round,
    excess_cases_by_all_csr_population,
    excess_cases_by_all_csr_population_round,
    observed_expected_ratio_by_all_csr_population,
    observed_expected_ratio_by_all_csr_population_round,
    
