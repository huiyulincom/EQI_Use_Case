# SCREEN group's share of total population among all CSR-matched blocks.
# =========================================================

all_csr_matched_blocks <- matched_df %>%
  distinct(
    eqi_poly_id,
    SCREEN,
    POP20
  )

all_csr_population_baseline_by_screen <- all_csr_matched_blocks %>%
  group_by(SCREEN) %>%
  summarise(
    all_csr_screen_block_count = n_distinct(eqi_poly_id),
    all_csr_screen_population = sum(POP20, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    all_csr_total_matched_block_count =
      sum(all_csr_screen_block_count, na.rm = TRUE),
    
    all_csr_total_population =
      sum(all_csr_screen_population, na.rm = TRUE),
    
    all_csr_screen_population_share =
      if_else(
        all_csr_total_population > 0,
        all_csr_screen_population / all_csr_total_population,
        NA_real_
      ),
    
    all_csr_screen_population_share_label =
      paste0(round(all_csr_screen_population_share * 100, 2), "%")
  ) %>%
  arrange(SCREEN)


