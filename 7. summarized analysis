  summarise(
    urban_case_count =
      sum(UR20 == "Urban", na.rm = TRUE),
    
    rural_case_count =
      sum(UR20 == "Rural", na.rm = TRUE),
    
    unknown_ur20_case_count =
      sum(UR20 == "Unknown", na.rm = TRUE),
    
    total_ur20_case_count = n(),
    
    urban_case_share =
      if_else(
        total_ur20_case_count > 0,
        urban_case_count / total_ur20_case_count,
        NA_real_
      ),
    
    rural_case_share =
      if_else(
        total_ur20_case_count > 0,
        rural_case_count / total_ur20_case_count,
        NA_real_
      ),
    
    .groups = "drop"
  ) %>%
  mutate(
    urban_case_share_label =
      paste0(round(urban_case_share * 100, 2), "%"),
    
    rural_case_share_label =
      paste0(round(rural_case_share * 100, 2), "%")
  )


# ---------------------------------------------------------
# 16C. Urban / rural response and resolution time
#     This creates separate urban/rural mean and median columns.
# ---------------------------------------------------------

category_screen_ur20_time_wide <- matched_df %>%
  group_by(
    Customer_Service_Requested,
    SCREEN,
    UR20
  ) %>%
  summarise(
    ur20_case_count = n(),
    
    response_valid_n = sum(!is.na(response_days)),
    response_mean = mean(response_days, na.rm = TRUE),
    response_median = median(response_days, na.rm = TRUE),
    
    resolution_valid_n = sum(!is.na(resolution_days)),
    resolution_mean = mean(resolution_days, na.rm = TRUE),
    resolution_median = median(resolution_days, na.rm = TRUE),
    
    .groups = "drop"
  ) %>%
  mutate(
    response_mean = if_else(is.nan(response_mean), NA_real_, response_mean),
    response_median = if_else(is.nan(response_median), NA_real_, response_median),
    resolution_mean = if_else(is.nan(resolution_mean), NA_real_, resolution_mean),
    resolution_median = if_else(is.nan(resolution_median), NA_real_, resolution_median),
    
    UR20 = str_to_lower(UR20)
  ) %>%
  pivot_wider(
    names_from = UR20,
    values_from = c(
      ur20_case_count,
      response_valid_n,
      response_mean,
      response_median,
      resolution_valid_n,
      resolution_mean,
      resolution_median
    ),
    names_glue = "{UR20}_{.value}"
  ) %>%
  mutate(
    across(
      where(is.numeric),
      ~ if_else(is.nan(.x), NA_real_, .x)
    ),
    
    urban_response_mean_round = round(urban_response_mean, 2),
    urban_response_median_round = round(urban_response_median, 2),
    urban_resolution_mean_round = round(urban_resolution_mean, 2),
    urban_resolution_median_round = round(urban_resolution_median, 2),
    
    rural_response_mean_round = round(rural_response_mean, 2),
    rural_response_median_round = round(rural_response_median, 2),
    rural_resolution_mean_round = round(rural_resolution_mean, 2),
    rural_resolution_median_round = round(rural_resolution_median, 2)
  )


# ---------------------------------------------------------
# 16D. Combine overrepresentation and time summaries
# ---------------------------------------------------------

category_screen_combined_prioritization_summary <- category_screen_observed_expected_population %>%
  left_join(
    category_screen_time_summary,
    by = c("Customer_Service_Requested", "SCREEN")
  ) %>%
  left_join(
    category_screen_ur20_counts,
    by = c("Customer_Service_Requested", "SCREEN")
  ) %>%
  left_join(
    category_screen_ur20_time_wide,
    by = c("Customer_Service_Requested", "SCREEN")
  ) %>%
  mutate(
    response_resolution_note = case_when(
      response_time_valid_n == 0 & resolution_time_valid_n == 0 ~
        "No valid response or resolution dates",
      
      response_time_valid_n == 0 ~
        "No valid response dates",
      
      resolution_time_valid_n == 0 ~
        "No valid resolution dates",
      
      TRUE ~
        "Valid time summary"
    ),
    
    priority_review_group = case_when(
      population_representation_level %in% c("Elevated", "Strongly elevated") &
        !is.na(response_days_mean) &
        response_days_mean >= median(response_days_mean, na.rm = TRUE) ~
        "Elevated representation + slower response",
      
      population_representation_level %in% c("Elevated", "Strongly elevated") &
        !is.na(resolution_days_mean) &
        resolution_days_mean >= median(resolution_days_mean, na.rm = TRUE) ~
        "Elevated representation + slower resolution",
      
      population_representation_level == "Moderately elevated" ~
        "Moderately elevated representation",
      
      population_representation_level %in% c("Elevated", "Strongly elevated") ~
        "Elevated representation",
      
      TRUE ~
        "General monitoring"
    )
  ) %>%
  select(
    # -----------------------------------------------------
    # Main identifiers
    # -----------------------------------------------------
    Customer_Service_Requested,
    SCREEN,
    
    # -----------------------------------------------------
    # Case count and overrepresentation
    # -----------------------------------------------------
    observed_case_count,
    total_cases_in_category,
    observed_case_share_within_category,
    observed_case_share_within_category_label,
    
    all_csr_screen_population,
    all_csr_total_population,
    all_csr_screen_population_share,
    all_csr_screen_population_share_label,
    
    expected_cases_by_all_csr_population,
    expected_cases_by_all_csr_population_round,
    excess_cases_by_all_csr_population,
    excess_cases_by_all_csr_population_round,
    observed_expected_ratio_by_all_csr_population,
    observed_expected_ratio_by_all_csr_population_round,
    
    population_representation_level,
    prioritization_flag,
    interpretation,
    
    # -----------------------------------------------------
    # Overall response and resolution time
    # -----------------------------------------------------
    response_time_valid_n,
    response_days_mean,
    response_days_mean_round,
    response_days_median,
    response_days_median_round,
    response_days_p75,
    response_days_p75_round,
    response_days_p90,
    response_days_p90_round,
    response_days_missing_n,
    
    resolution_time_valid_n,
    resolution_days_mean,
    resolution_days_mean_round,
    resolution_days_median,
    resolution_days_median_round,
    resolution_days_p75,
    resolution_days_p75_round,
    resolution_days_p90,
    resolution_days_p90_round,
    resolution_days_missing_n,
    
    response_resolution_note,
    
    # -----------------------------------------------------
    # Urban / rural count
    # -----------------------------------------------------
    urban_case_count,
    rural_case_count,
    unknown_ur20_case_count,
    total_ur20_case_count,
    urban_case_share,
    urban_case_share_label,
    rural_case_share,
    rural_case_share_label,
    
    # -----------------------------------------------------
    # Urban response/resolution time
    # -----------------------------------------------------
    urban_ur20_case_count,
    urban_response_valid_n,
    urban_response_mean,
    urban_response_mean_round,
    urban_response_median,
    urban_response_median_round,
    urban_resolution_valid_n,
    urban_resolution_mean,
    urban_resolution_mean_round,
    urban_resolution_median,
    urban_resolution_median_round,
    
    # -----------------------------------------------------
    # Rural response/resolution time
    # -----------------------------------------------------
    rural_ur20_case_count,
    rural_response_valid_n,
    rural_response_mean,
    rural_response_mean_round,
    rural_response_median,
    rural_response_median_round,
    rural_resolution_valid_n,
    rural_resolution_mean,
    rural_resolution_mean_round,
    rural_resolution_median,
    rural_resolution_median_round,
    
    # -----------------------------------------------------
    # Final review group
    # -----------------------------------------------------
    priority_review_group
  ) %>%
  arrange(
    desc(population_representation_level == "Strongly elevated"),
    desc(population_representation_level == "Elevated"),
    desc(population_representation_level == "Moderately elevated"),
    desc(observed_expected_ratio_by_all_csr_population),
    desc(response_days_mean),
    desc(resolution_days_mean),
    Customer_Service_Requested,
    SCREEN
  )

# =========================================================
# 16. Category overview summary
#
# This answers:
# - total cases in each category
# - how many SCREEN groups it falls into
# - how many UR20 groups it falls into
# - average response/resolution time
# - how many SCREEN groups are elevated
# =========================================================

category_screen_count_summary <- matched_df %>%
  group_by(Customer_Service_Requested) %>%
  summarise(
    total_matched_cases = n(),
    
    number_of_screen_groups_with_cases =
      n_distinct(SCREEN),
    
    screen_groups_with_cases =
      paste(sort(unique(SCREEN)), collapse = "; "),
    
    number_of_ur20_groups_with_cases =
      n_distinct(UR20),
    
    ur20_groups_with_cases =
      paste(sort(unique(UR20)), collapse = "; "),
    
    category_response_valid_n =
      sum(!is.na(response_days)),
    
    category_response_days_mean =
      mean(response_days, na.rm = TRUE),
    
    category_response_days_median =
      median(response_days, na.rm = TRUE),
    
    category_resolution_valid_n =
      sum(!is.na(resolution_days)),
    
    category_resolution_days_mean =
      mean(resolution_days, na.rm = TRUE),
    
    category_resolution_days_median =
      median(resolution_days, na.rm = TRUE),
    
    .groups = "drop"
  ) %>%
  mutate(
    category_response_days_mean = if_else(
      is.nan(category_response_days_mean),
      NA_real_,
      category_response_days_mean
    ),
    category_response_days_median = if_else(
      is.nan(category_response_days_median),
      NA_real_,
      category_response_days_median
    ),
    category_resolution_days_mean = if_else(
      is.nan(category_resolution_days_mean),
      NA_real_,
      category_resolution_days_mean
    ),
    category_resolution_days_median = if_else(
      is.nan(category_resolution_days_median),
      NA_real_,
      category_resolution_days_median
    ),
    
    category_response_days_mean_round =
      round(category_response_days_mean, 2),
    
    category_response_days_median_round =
      round(category_response_days_median, 2),
    
    category_resolution_days_mean_round =
      round(category_resolution_days_mean, 2),
    
    category_resolution_days_median_round =
      round(category_resolution_days_median, 2)
  )

category_elevated_screen_summary <- category_screen_observed_expected_population %>%
  group_by(Customer_Service_Requested) %>%
  summarise(
    number_of_moderately_or_more_elevated_screen_groups =
      sum(population_moderately_or_more_elevated, na.rm = TRUE),
    
    number_of_clearly_or_more_elevated_screen_groups =
      sum(population_clearly_or_more_elevated, na.rm = TRUE),
    
    elevated_screen_groups =
      paste(
        SCREEN[population_moderately_or_more_elevated == TRUE],
        collapse = "; "
      ),
    
    max_observed_expected_ratio_population =
      max(observed_expected_ratio_by_all_csr_population, na.rm = TRUE),
    
    top_screen_by_population_ratio =
      SCREEN[
        which.max(
          replace_na(observed_expected_ratio_by_all_csr_population, -Inf)
        )
      ],
    
    .groups = "drop"
  ) %>%
  mutate(
    max_observed_expected_ratio_population = if_else(
      is.infinite(max_observed_expected_ratio_population),
      NA_real_,
      max_observed_expected_ratio_population
    ),
    
    max_observed_expected_ratio_population_round =
      round(max_observed_expected_ratio_population, 2)
  )

category_overview_summary <- category_screen_count_summary %>%
  left_join(
    category_elevated_screen_summary,
    by = "Customer_Service_Requested"
  ) %>%
  arrange(
    desc(number_of_clearly_or_more_elevated_screen_groups),
    desc(number_of_moderately_or_more_elevated_screen_groups),
    desc(total_matched_cases)
  )


