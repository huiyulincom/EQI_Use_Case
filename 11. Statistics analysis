# =========================================================
# 11. Observed vs expected by category x SCREEN
#
# Statistical significance:
# One-sided Poisson test.
# H0: observed is consistent with expected.
# H1: observed is greater than expected.
#
# Multiple testing:
# Benjamini-Hochberg FDR correction.
# =========================================================

observed_category_screen_raw <- matched_df %>%
  count(
    Customer_Service_Requested,
    SCREEN,
    name = "observed_case_count"
  )

all_categories <- observed_category_screen_raw %>%
  distinct(Customer_Service_Requested)

all_screens <- all_csr_population_baseline_by_screen %>%
  distinct(SCREEN)

observed_category_screen <- tidyr::crossing(
  all_categories,
  all_screens
) %>%
  left_join(
    observed_category_screen_raw,
    by = c("Customer_Service_Requested", "SCREEN")
  ) %>%
  mutate(
    observed_case_count = replace_na(observed_case_count, 0L)
  ) %>%
  group_by(Customer_Service_Requested) %>%
  mutate(
    total_cases_in_category = sum(observed_case_count),
    
    observed_case_share_within_category =
      if_else(
        total_cases_in_category > 0,
        observed_case_count / total_cases_in_category,
        NA_real_
      ),
    
    observed_case_share_within_category_label =
      paste0(round(observed_case_share_within_category * 100, 2), "%")
  ) %>%
  ungroup()

category_screen_overrepresentation <- observed_category_screen %>%
  left_join(
    all_csr_population_baseline_by_screen,
    by = "SCREEN"
  ) %>%
  mutate(
    expected_cases_by_all_csr_population =
      total_cases_in_category * all_csr_screen_population_share,
    
    observed_expected_ratio_by_all_csr_population =
      if_else(
        expected_cases_by_all_csr_population > 0,
        observed_case_count / expected_cases_by_all_csr_population,
        NA_real_
      ),
    
    excess_cases_by_all_csr_population =
      observed_case_count - expected_cases_by_all_csr_population,
    
    expected_cases_by_all_csr_population_round =
      round(expected_cases_by_all_csr_population, 2),
    
    excess_cases_by_all_csr_population_round =
      round(excess_cases_by_all_csr_population, 2),
    
    observed_expected_ratio_by_all_csr_population_round =
      round(observed_expected_ratio_by_all_csr_population, 2),
    
    population_representation_level =
      get_representation_level(
        observed_expected_ratio_by_all_csr_population,
        observed_case_count
      ),
    
    population_moderately_or_more_elevated =
      population_representation_level %in%
      c("Moderately elevated", "Elevated", "Strongly elevated"),
    
    population_clearly_or_more_elevated =
      population_representation_level %in%
      c("Elevated", "Strongly elevated"),
    
    population_strongly_elevated =
      population_representation_level == "Strongly elevated",
    
    p_value_poisson_overrep = case_when(
      !is.na(expected_cases_by_all_csr_population) &
        expected_cases_by_all_csr_population > 0 &
        observed_case_count >= min_case_count ~
        ppois(
          q = observed_case_count - 1,
          lambda = expected_cases_by_all_csr_population,
          lower.tail = FALSE
        ),
      
      TRUE ~ NA_real_
    ),
    
    prioritization_flag = case_when(
      observed_case_count < min_case_count ~
        "Low case count",
      
      population_representation_level == "Strongly elevated" ~
        "High priority pattern",
      
      population_representation_level == "Elevated" ~
        "Elevated priority pattern",
      
      population_representation_level == "Moderately elevated" ~
        "Moderate priority pattern",
      
      population_representation_level == "Below expected" ~
        "Below expected",
      
      population_representation_level == "Close to expected" ~
        "Close to expected",
      
      TRUE ~
        "Review"
    )
  )

category_screen_overrepresentation <- category_screen_overrepresentation %>%
  mutate(
    p_value_poisson_overrep_fdr =
      p.adjust(p_value_poisson_overrep, method = "BH"),
    
    p_value_poisson_overrep_round =
      round(p_value_poisson_overrep, 5),
    
    p_value_poisson_overrep_fdr_round =
      round(p_value_poisson_overrep_fdr, 5),
    
    statistically_significant_overrep = case_when(
      is.na(p_value_poisson_overrep_fdr) ~
        "Not tested",
      
      observed_case_count < min_case_count ~
        "Not tested: low case count",
      
      observed_expected_ratio_by_all_csr_population <= 1 ~
        "Not significant overrepresentation",
      
      p_value_poisson_overrep_fdr < 0.05 ~
        "Statistically significant overrepresentation",
      
      TRUE ~
        "Not statistically significant"
    ),
    
    overrep_interpretation = case_when(
      population_moderately_or_more_elevated == TRUE &
        statistically_significant_overrep == "Statistically significant overrepresentation" ~
        "Elevated ratio and statistically significant",
      
      population_moderately_or_more_elevated == TRUE &
        statistically_significant_overrep != "Statistically significant overrepresentation" ~
        "Elevated ratio but not statistically significant",
      
      population_representation_level == "Below expected" ~
        "Below expected",
      
      population_representation_level == "Close to expected" ~
        "Close to expected",
      
      observed_case_count < min_case_count ~
        "Low case count",
      
      TRUE ~
        population_representation_level
    )
  ) %>%
  arrange(
    Customer_Service_Requested,
    desc(statistically_significant_overrep == "Statistically significant overrepresentation"),
