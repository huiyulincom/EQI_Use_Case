library(sf)
library(dplyr)
library(stringr)
library(readr)
library(tidyr)

# =========================================================
# 1. User inputs
# =========================================================

gdb_path_points <- "C:/Users/s160418/OneDrive - California Department of Transportation/Desktop/ESTA/EQI Use Case/Maintenance/Maintenance_CSR/Maintenance_CSR.gdb"
layer_points    <- "CSR_02_23_2026_Projected"

gdb_path_eqi <- "C:/Users/s160418/OneDrive - California Department of Transportation/Desktop/ESTA/EQI Use Case/Maintenance/Maintenance_CSR/Maintenance_CSR.gdb"
layer_eqi    <- "EQI_Shapefile_ExportFeatures"

field_request <- "Customer_Service_Requested"
field_screen  <- "SCREEN"
field_pop     <- "POP20"

# Optional: if EQI polygon layer already has a stable unique ID field, use it here
eqi_id_field <- NULL
# eqi_id_field <- "OBJECTID"

# Use local output folder to avoid OneDrive writing issues
output_folder <- "C:/Users/s160418/Desktop/CSR_All_CSR_Matched_Block_Baseline_Output"

if (!dir.exists(output_folder)) {
  dir.create(output_folder, recursive = TRUE)
}

output_baseline_csv <- file.path(
  output_folder,
  "01_all_csr_matched_block_baseline.csv"
)

output_observed_expected_csv <- file.path(
  output_folder,
  "02_all_csr_matched_block_observed_expected.csv"
)

output_overrepresented_csv <- file.path(
  output_folder,
  "03_all_csr_matched_block_overrepresented_only.csv"
)

output_all_screen_summary_csv <- file.path(
  output_folder,
  "04_all_csr_matched_block_all_screen_summary.csv"
)

# Thresholds
min_case_count <- 10
overrepresented_ratio_threshold <- 1.5
underrepresented_ratio_threshold <- 0.67


# =========================================================
# 2. Safe CSV writer
# =========================================================

safe_write_csv <- function(df, path) {
  
  cat("\nPreparing to write:\n", path, "\n")
  cat("Rows:", nrow(df), " Columns:", ncol(df), "\n")
  
  df <- as.data.frame(df)
  
  if ("geometry" %in% names(df)) {
    df$geometry <- NULL
  }
  
  list_cols <- names(df)[sapply(df, is.list)]
  if (length(list_cols) > 0) {
    for (col in list_cols) {
      df[[col]] <- as.character(df[[col]])
    }
  }
  
  numeric_cols <- names(df)[sapply(df, is.numeric)]
  if (length(numeric_cols) > 0) {
    for (col in numeric_cols) {
      df[[col]][is.infinite(df[[col]]) | is.nan(df[[col]])] <- NA_real_
    }
  }
  
  if (file.exists(path)) {
    file.remove(path)
  }
  
  if (requireNamespace("data.table", quietly = TRUE)) {
    data.table::fwrite(
      df,
      file = path,
      na = ""
    )
  } else {
    utils::write.csv(
      df,
      file = path,
      row.names = FALSE,
      na = ""
    )
  }
  
  cat("Finished writing:\n", path, "\n")
}


# =========================================================
# 3. Read data
# =========================================================

cat("\nReading point layer...\n")
points_sf <- st_read(gdb_path_points, layer = layer_points, quiet = FALSE)

cat("\nReading EQI polygon layer...\n")
eqi_sf <- st_read(gdb_path_eqi, layer = layer_eqi, quiet = FALSE)


# =========================================================
# 4. Check required fields
# =========================================================

if (!(field_request %in% names(points_sf))) {
  stop(
    paste0(
      "Field '", field_request, "' was not found in point layer.\n",
      "Available fields:\n",
      paste(names(points_sf), collapse = ", ")
    )
  )
}

if (!(field_screen %in% names(eqi_sf))) {
  stop(
    paste0(
      "Field '", field_screen, "' was not found in EQI layer.\n",
      "Available fields:\n",
      paste(names(eqi_sf), collapse = ", ")
    )
  )
}

if (!(field_pop %in% names(eqi_sf))) {
  stop(
    paste0(
      "Field '", field_pop, "' was not found in EQI layer.\n",
      "Available fields:\n",
      paste(names(eqi_sf), collapse = ", ")
    )
  )
}


# =========================================================
# 5. Match CRS
# =========================================================

if (st_crs(points_sf) != st_crs(eqi_sf)) {
  eqi_sf <- st_transform(eqi_sf, st_crs(points_sf))
}


# =========================================================
# 6. Create unique EQI polygon ID
# =========================================================

if (!is.null(eqi_id_field)) {
  
  if (!(eqi_id_field %in% names(eqi_sf))) {
    stop(
      paste0(
        "eqi_id_field '", eqi_id_field, "' was not found in EQI layer."
      )
    )
  }
  
  eqi_sf <- eqi_sf %>%
    mutate(eqi_poly_id = as.character(.data[[eqi_id_field]]))
  
} else {
  
  eqi_sf <- eqi_sf %>%
    mutate(eqi_poly_id = as.character(row_number()))
}


# =========================================================
# 7. Clean attributes
# =========================================================

points_clean <- points_sf %>%
  select(all_of(field_request)) %>%
  mutate(
    Customer_Service_Requested = as.character(.data[[field_request]]),
    Customer_Service_Requested = str_squish(Customer_Service_Requested),
    Customer_Service_Requested = na_if(Customer_Service_Requested, ""),
    Customer_Service_Requested = if_else(
      is.na(Customer_Service_Requested),
      "NA / Blank",
      Customer_Service_Requested
    )
  )

eqi_clean <- eqi_sf %>%
  select(eqi_poly_id, all_of(field_screen), all_of(field_pop)) %>%
  mutate(
    SCREEN = as.character(.data[[field_screen]]),
    SCREEN = str_squish(SCREEN),
    SCREEN = na_if(SCREEN, ""),
    SCREEN = if_else(
      is.na(SCREEN),
      "NA / Blank",
      SCREEN
    ),
    POP20 = suppressWarnings(as.numeric(.data[[field_pop]])),
    POP20 = if_else(is.na(POP20), 0, POP20)
  )


# =========================================================
# 8. Spatial join
#    Assign each CSR point to an EQI polygon
# =========================================================

cat("\nRunning spatial join...\n")

joined_sf <- st_join(points_clean, eqi_clean, left = TRUE)

joined_df <- joined_sf %>%
  st_drop_geometry() %>%
  mutate(
    SCREEN = if_else(
      is.na(SCREEN),
      "Outside polygon / No match",
      SCREEN
    ),
    eqi_poly_id = if_else(
      is.na(eqi_poly_id),
      "No_match",
      eqi_poly_id
    ),
    POP20 = if_else(
      is.na(POP20),
      0,
      POP20
    )
  )

cat("\nSpatial join finished.\n")
cat("Joined rows:", nrow(joined_df), "\n")


# =========================================================
# 9. Keep only matched CSR records
# =========================================================

matched_df <- joined_df %>%
  filter(
    !is.na(Customer_Service_Requested),
    !is.na(SCREEN),
    eqi_poly_id != "No_match",
    SCREEN != "Outside polygon / No match"
  )

cat("\nMatched CSR records:", nrow(matched_df), "\n")


# =========================================================
# 10. All CSR matched-block baseline
#
# This baseline uses all unique EQI polygons where any CSR point appeared.
#
# It answers:
# Compared with the overall CSR reporting geography,
# is a specific CSR category overrepresented in a SCREEN group?
# =========================================================

all_csr_matched_blocks <- matched_df %>%
  distinct(
    eqi_poly_id,
    SCREEN,
    POP20
  )

all_csr_matched_block_baseline <- all_csr_matched_blocks %>%
  group_by(SCREEN) %>%
  summarise(
    all_csr_screen_block_count = n_distinct(eqi_poly_id),
    all_csr_screen_population = sum(POP20, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    all_csr_total_matched_block_count =
      sum(all_csr_screen_block_count, na.rm = TRUE),
    
    all_csr_total_matched_population =
      sum(all_csr_screen_population, na.rm = TRUE),
    
    all_csr_screen_block_share =
      all_csr_screen_block_count / all_csr_total_matched_block_count,
    
    all_csr_screen_population_share =
      if_else(
        all_csr_total_matched_population > 0,
        all_csr_screen_population / all_csr_total_matched_population,
        NA_real_
      ),
    
    all_csr_screen_block_share_label =
      paste0(round(all_csr_screen_block_share * 100, 2), "%"),
    
    all_csr_screen_population_share_label =
      paste0(round(all_csr_screen_population_share * 100, 2), "%")
  ) %>%
  arrange(SCREEN)


# =========================================================
# 11. Observed cases by category x SCREEN
# =========================================================

observed_category_screen_raw <- matched_df %>%
  count(
    Customer_Service_Requested,
    SCREEN,
    name = "observed_case_count"
  )

# Complete category x SCREEN table.
# This keeps zero-case SCREEN groups too, based on the all-CSR baseline.
all_categories <- observed_category_screen_raw %>%
  distinct(Customer_Service_Requested)

all_screens <- all_csr_matched_block_baseline %>%
  distinct(SCREEN)

observed_category_screen <- tidyr::crossing(
  all_categories,
  all_screens
) %>%
  left_join(
    observed_category_screen_raw,
    by = c("Customer_Service_Requested", "SCREEN")
  ) %>%
  mutate(
    observed_case_count = replace_na(observed_case_count, 0L)
  ) %>%
  group_by(Customer_Service_Requested) %>%
  mutate(
    total_cases_in_category = sum(observed_case_count),
    
    observed_case_share_within_category =
      if_else(
        total_cases_in_category > 0,
        observed_case_count / total_cases_in_category,
        NA_real_
      ),
    
    observed_case_share_within_category_label =
      paste0(round(observed_case_share_within_category * 100, 2), "%")
  ) %>%
  ungroup()


# =========================================================
# 12. Observed vs expected using all CSR matched-block baseline
#
# Expected cases by block count:
# If this category followed the overall CSR matched-block distribution,
# how many cases would each SCREEN group have?
#
# Expected cases by population:
# If this category followed the population distribution of all CSR
# matched blocks, how many cases would each SCREEN group have?
# =========================================================

all_csr_observed_expected <- observed_category_screen %>%
  left_join(
    all_csr_matched_block_baseline,
    by = "SCREEN"
  ) %>%
  mutate(
    # -----------------------------------------------------
    # Expected cases by all-CSR matched block-count baseline
    # -----------------------------------------------------
    expected_cases_by_all_csr_block_count =
      total_cases_in_category * all_csr_screen_block_share,
    
    observed_expected_ratio_by_all_csr_block_count =
      if_else(
        expected_cases_by_all_csr_block_count > 0,
        observed_case_count / expected_cases_by_all_csr_block_count,
        NA_real_
      ),
    
    excess_cases_by_all_csr_block_count =
      observed_case_count - expected_cases_by_all_csr_block_count,
    
    # -----------------------------------------------------
    # Expected cases by all-CSR matched population baseline
    # -----------------------------------------------------
    expected_cases_by_all_csr_population =
      total_cases_in_category * all_csr_screen_population_share,
    
    observed_expected_ratio_by_all_csr_population =
      if_else(
        expected_cases_by_all_csr_population > 0,
        observed_case_count / expected_cases_by_all_csr_population,
        NA_real_
      ),
    
    excess_cases_by_all_csr_population =
      observed_case_count - expected_cases_by_all_csr_population,
    
    # -----------------------------------------------------
    # Rounded columns
    # -----------------------------------------------------
    expected_cases_by_all_csr_block_count_round =
      round(expected_cases_by_all_csr_block_count, 2),
    
    expected_cases_by_all_csr_population_round =
      round(expected_cases_by_all_csr_population, 2),
    
    excess_cases_by_all_csr_block_count_round =
      round(excess_cases_by_all_csr_block_count, 2),
    
    excess_cases_by_all_csr_population_round =
      round(excess_cases_by_all_csr_population, 2),
    
    observed_expected_ratio_by_all_csr_block_count_round =
      round(observed_expected_ratio_by_all_csr_block_count, 2),
    
    observed_expected_ratio_by_all_csr_population_round =
      round(observed_expected_ratio_by_all_csr_population, 2),
    
    # -----------------------------------------------------
    # Interpretation flags
    # -----------------------------------------------------
    overrepresented_by_all_csr_block_count = if_else(
      observed_case_count >= min_case_count &
        !is.na(observed_expected_ratio_by_all_csr_block_count) &
        observed_expected_ratio_by_all_csr_block_count >= overrepresented_ratio_threshold,
      TRUE,
      FALSE
    ),
    
    overrepresented_by_all_csr_population = if_else(
      observed_case_count >= min_case_count &
        !is.na(observed_expected_ratio_by_all_csr_population) &
        observed_expected_ratio_by_all_csr_population >= overrepresented_ratio_threshold,
      TRUE,
      FALSE
    ),
    
    underrepresented_by_all_csr_block_count = if_else(
      observed_case_count >= min_case_count &
        !is.na(observed_expected_ratio_by_all_csr_block_count) &
        observed_expected_ratio_by_all_csr_block_count <= underrepresented_ratio_threshold,
      TRUE,
      FALSE
    ),
    
    underrepresented_by_all_csr_population = if_else(
      observed_case_count >= min_case_count &
        !is.na(observed_expected_ratio_by_all_csr_population) &
        observed_expected_ratio_by_all_csr_population <= underrepresented_ratio_threshold,
      TRUE,
      FALSE
    ),
    
    strongly_overrepresented_all_csr = if_else(
      overrepresented_by_all_csr_block_count == TRUE &
        overrepresented_by_all_csr_population == TRUE,
      TRUE,
      FALSE
    ),
    
    strongly_underrepresented_all_csr = if_else(
      underrepresented_by_all_csr_block_count == TRUE &
        underrepresented_by_all_csr_population == TRUE,
      TRUE,
      FALSE
    )
  ) %>%
  select(
    Customer_Service_Requested,
    SCREEN,
    
    observed_case_count,
    total_cases_in_category,
    observed_case_share_within_category,
    observed_case_share_within_category_label,
    
    all_csr_screen_block_count,
    all_csr_total_matched_block_count,
    all_csr_screen_block_share,
    all_csr_screen_block_share_label,
    expected_cases_by_all_csr_block_count,
    expected_cases_by_all_csr_block_count_round,
    excess_cases_by_all_csr_block_count,
    excess_cases_by_all_csr_block_count_round,
    observed_expected_ratio_by_all_csr_block_count,
    observed_expected_ratio_by_all_csr_block_count_round,
    
    all_csr_screen_population,
    all_csr_total_matched_population,
    all_csr_screen_population_share,
    all_csr_screen_population_share_label,
    expected_cases_by_all_csr_population,
    expected_cases_by_all_csr_population_round,
    excess_cases_by_all_csr_population,
    excess_cases_by_all_csr_population_round,
    observed_expected_ratio_by_all_csr_population,
    observed_expected_ratio_by_all_csr_population_round,
    
    overrepresented_by_all_csr_block_count,
    overrepresented_by_all_csr_population,
    underrepresented_by_all_csr_block_count,
    underrepresented_by_all_csr_population,
    strongly_overrepresented_all_csr,
    strongly_underrepresented_all_csr
  ) %>%
  arrange(
    Customer_Service_Requested,
    desc(strongly_overrepresented_all_csr),
    desc(observed_expected_ratio_by_all_csr_population),
    desc(observed_expected_ratio_by_all_csr_block_count),
    desc(observed_case_count)
  )


# =========================================================
# 13. Overrepresented-only table
# =========================================================

all_csr_overrepresented_only <- all_csr_observed_expected %>%
  filter(
    observed_case_count >= min_case_count
  ) %>%
  filter(
    observed_expected_ratio_by_all_csr_population >= overrepresented_ratio_threshold |
      observed_expected_ratio_by_all_csr_block_count >= overrepresented_ratio_threshold
  ) %>%
  arrange(
    desc(strongly_overrepresented_all_csr),
    desc(observed_expected_ratio_by_all_csr_population),
    desc(observed_expected_ratio_by_all_csr_block_count),
    desc(observed_case_count)
  )


# =========================================================
# 14. All SCREEN groups per category summary
#
# This keeps all SCREEN groups for each category.
# =========================================================

all_csr_all_screen_summary <- all_csr_observed_expected %>%
  mutate(
    ranking_ratio = coalesce(
      observed_expected_ratio_by_all_csr_population,
      observed_expected_ratio_by_all_csr_block_count
    ),
    
    interpretation = case_when(
      strongly_overrepresented_all_csr == TRUE ~
        "Strongly overrepresented by both all-CSR block count and all-CSR population",
      
      overrepresented_by_all_csr_population == TRUE &
        overrepresented_by_all_csr_block_count == FALSE ~
        "Overrepresented by all-CSR population baseline only",
      
      overrepresented_by_all_csr_block_count == TRUE &
        overrepresented_by_all_csr_population == FALSE ~
        "Overrepresented by all-CSR block-count baseline only",
      
      strongly_underrepresented_all_csr == TRUE ~
        "Strongly underrepresented by both all-CSR block count and all-CSR population",
      
      underrepresented_by_all_csr_population == TRUE &
        underrepresented_by_all_csr_block_count == FALSE ~
        "Underrepresented by all-CSR population baseline only",
      
      underrepresented_by_all_csr_block_count == TRUE &
        underrepresented_by_all_csr_population == FALSE ~
        "Underrepresented by all-CSR block-count baseline only",
      
      TRUE ~
        "Close to expected or low case count"
    )
  ) %>%
  arrange(
    Customer_Service_Requested,
    desc(strongly_overrepresented_all_csr),
    desc(ranking_ratio),
    desc(observed_case_count)
  )


# =========================================================
# 15. Export outputs
# =========================================================

cat("\nExporting outputs...\n")

safe_write_csv(
  all_csr_matched_block_baseline,
  output_baseline_csv
)

safe_write_csv(
  all_csr_observed_expected,
  output_observed_expected_csv
)

safe_write_csv(
  all_csr_overrepresented_only,
  output_overrepresented_csv
)

safe_write_csv(
  all_csr_all_screen_summary,
  output_all_screen_summary_csv
)

cat("\nDone: all CSR matched-block baseline analysis.\n")

cat("\nOutputs saved to:\n")
cat(output_baseline_csv, "\n")
cat(output_observed_expected_csv, "\n")
cat(output_overrepresented_csv, "\n")
cat(output_all_screen_summary_csv, "\n")

cat("\nOutput row counts:\n")
cat("01_all_csr_matched_block_baseline:", nrow(all_csr_matched_block_baseline), "\n")
cat("02_all_csr_matched_block_observed_expected:", nrow(all_csr_observed_expected), "\n")
cat("03_all_csr_matched_block_overrepresented_only:", nrow(all_csr_overrepresented_only), "\n")
cat("04_all_csr_matched_block_all_screen_summary:", nrow(all_csr_all_screen_summary), "\n")
