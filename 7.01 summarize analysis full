parse_csr_date <- function(x) {
  
  if (inherits(x, "Date")) {
    return(x)
  }
  
  if (inherits(x, "POSIXct") | inherits(x, "POSIXlt")) {
    return(as.Date(x))
  }
  
  x_chr <- as.character(x)
  x_chr <- str_squish(x_chr)
  x_chr[x_chr == ""] <- NA_character_
  
  parsed <- suppressWarnings(as.Date(x_chr))
  
  parsed <- if_else(
    is.na(parsed),
    suppressWarnings(as.Date(mdy(x_chr))),
    parsed
  )
  
  parsed <- if_else(
    is.na(parsed),
    suppressWarnings(as.Date(ymd(x_chr))),
    parsed
  )
  
  parsed <- if_else(
    is.na(parsed),
    suppressWarnings(as.Date(mdy_hms(x_chr))),
    parsed
  )
  
  parsed <- if_else(
    is.na(parsed),
    suppressWarnings(as.Date(ymd_hms(x_chr))),
    parsed
  )
  
  parsed
}

mean_or_na <- function(x) {
  if (all(is.na(x))) {
    return(NA_real_)
  } else {
    return(mean(x, na.rm = TRUE))
  }
}

median_or_na <- function(x) {
  if (all(is.na(x))) {
    return(NA_real_)
  } else {
    return(median(x, na.rm = TRUE))
  }
}

quantile_or_na <- function(x, p) {
  if (all(is.na(x))) {
    return(NA_real_)
  } else {
    return(as.numeric(quantile(x, probs = p, na.rm = TRUE, names = FALSE)))
  }
}

safe_ratio <- function(numerator, denominator) {
  if_else(
    !is.na(numerator) & !is.na(denominator) & denominator > 0,
    numerator / denominator,
    NA_real_
  )
}

get_representation_level <- function(ratio, case_count) {
  case_when(
    is.na(ratio) ~ "No denominator",
    case_count < min_case_count ~ "Low case count",
    ratio < below_expected_threshold ~ "Below expected",
    ratio >= below_expected_threshold & ratio < moderately_elevated_threshold ~ "Close to expected",
    ratio >= moderately_elevated_threshold & ratio < elevated_threshold ~ "Moderately elevated",
    ratio >= elevated_threshold & ratio < strongly_elevated_threshold ~ "Elevated",
    ratio >= strongly_elevated_threshold ~ "Strongly elevated",
    TRUE ~ "Unclassified"
  )
}

get_delay_level <- function(ratio, valid_n) {
  case_when(
    is.na(ratio) ~ "No valid category baseline",
    is.na(valid_n) | valid_n < min_case_count ~ "Low valid time count",
    ratio < faster_than_category_threshold ~ "Faster than category typical",
    ratio >= faster_than_category_threshold & ratio < moderately_slower_threshold ~ "Similar to category typical",
    ratio >= moderately_slower_threshold & ratio < slower_threshold ~ "Moderately slower",
    ratio >= slower_threshold & ratio < much_slower_threshold ~ "Slower",
    ratio >= much_slower_threshold ~ "Much slower",
    TRUE ~ "Unclassified"
  )
}


