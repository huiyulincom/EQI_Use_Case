        "No valid response dates",
      
      resolution_time_valid_n == 0 ~
        "No valid resolution dates",
      
      TRUE ~
        "Valid time summary"
    ),
    
    delay_interpretation = case_when(
      response_typical_delay_flag == TRUE &
        resolution_typical_delay_flag == TRUE ~
        "Typical response and resolution times are slower than this category's overall pattern.",
      
      response_typical_delay_flag == TRUE &
        resolution_typical_delay_flag != TRUE ~
        "Typical response time is slower than this category's overall pattern.",
      
      resolution_typical_delay_flag == TRUE &
        response_typical_delay_flag != TRUE ~
        "Typical resolution time is slower than this category's overall pattern.",
      
      response_long_tail_delay_flag == TRUE &
        resolution_long_tail_delay_flag == TRUE ~
        "Mean response and resolution times are elevated but medians are not; possible long-tail backlog.",
      
      response_long_tail_delay_flag == TRUE ~
        "Mean response time is elevated but median is not; possible long-tail response backlog.",
      
      resolution_long_tail_delay_flag == TRUE ~
        "Mean resolution time is elevated but median is not; possible long-tail resolution backlog.",
      
      response_moderate_typical_delay_flag == TRUE |
        resolution_moderate_typical_delay_flag == TRUE ~
        "At least one typical time measure is moderately slower than this category's overall pattern.",
      
      TRUE ~
        "Time performance is similar to category pattern or insufficient data."
    ),
    
    priority_review_group = case_when(
      # Highest priority:
      # overrepresented and typical response/resolution is clearly slower
      population_clearly_or_more_elevated == TRUE &
        (
          response_typical_delay_flag == TRUE |
            resolution_typical_delay_flag == TRUE
