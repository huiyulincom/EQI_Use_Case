# =========================================================

points_clean <- points_sf %>%
  select(
    all_of(c(
      field_request,
      field_opened,
      field_responded,
      field_closed
    ))
  ) %>%
  mutate(
    Customer_Service_Requested = as.character(.data[[field_request]]),
    Customer_Service_Requested = str_squish(Customer_Service_Requested),
    Customer_Service_Requested = na_if(Customer_Service_Requested, ""),
    Customer_Service_Requested = if_else(
      is.na(Customer_Service_Requested),
      "NA / Blank",
      Customer_Service_Requested
    ),
    
    Date_Opened_raw = .data[[field_opened]],
    Date_Responded_raw = .data[[field_responded]],
    Date_Closed_raw = .data[[field_closed]],
    
    Date_Opened_clean = parse_csr_date(Date_Opened_raw),
    Date_Responded_clean = parse_csr_date(Date_Responded_raw),
    Date_Closed_clean = parse_csr_date(Date_Closed_raw),
    
    response_days = as.numeric(Date_Responded_clean - Date_Opened_clean),
    resolution_days = as.numeric(Date_Closed_clean - Date_Opened_clean),
    
    response_days = if_else(
      !is.na(response_days) & response_days >= 0,
      response_days,
      NA_real_
    ),
    
    resolution_days = if_else(
      !is.na(resolution_days) & resolution_days >= 0,
      resolution_days,
      NA_real_
    )
  )

eqi_clean <- eqi_sf %>%
  select(
    eqi_poly_id,
    all_of(c(field_screen, field_pop, field_ur20))
  ) %>%
  mutate(
    SCREEN = as.character(.data[[field_screen]]),
    SCREEN = str_squish(SCREEN),
    SCREEN = na_if(SCREEN, ""),
    SCREEN = if_else(
      is.na(SCREEN),
      "NA / Blank",
      SCREEN
    ),
    
    POP20 = suppressWarnings(as.numeric(.data[[field_pop]])),
    POP20 = if_else(is.na(POP20), 0, POP20),
    
    UR20 = as.character(.data[[field_ur20]]),
    UR20 = str_squish(UR20),
    UR20 = str_to_upper(UR20),
    UR20 = na_if(UR20, ""),
    UR20 = case_when(
      UR20 == "U" ~ "Urban",
      UR20 == "R" ~ "Rural",
      is.na(UR20) ~ "Unknown",
      TRUE ~ UR20
    )
  )


