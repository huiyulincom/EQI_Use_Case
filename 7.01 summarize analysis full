        "Priority review: elevated representation + moderate typical delay",
      
      # Elevated and long tail issue
      population_moderately_or_more_elevated == TRUE &
        (
          response_long_tail_delay_flag == TRUE |
            resolution_long_tail_delay_flag == TRUE
        ) ~
        "Backlog review: elevated representation + long-tail delay",
      
      # Elevated but no time issue
      population_clearly_or_more_elevated == TRUE ~
        "Elevated representation",
      
      population_moderately_or_more_elevated == TRUE ~
        "Moderately elevated representation",
      
      # Not elevated but slow
      response_typical_delay_flag == TRUE |
        resolution_typical_delay_flag == TRUE ~
        "Time delay review",
      
      response_long_tail_delay_flag == TRUE |
        resolution_long_tail_delay_flag == TRUE ~
        "Backlog review",
      
      TRUE ~
        "General monitoring"
    )
  ) %>%
