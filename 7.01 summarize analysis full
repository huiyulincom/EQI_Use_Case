      quantile_or_na(response_days, 0.90),
    
    response_days_missing_n =
      sum(is.na(response_days)),
    
    resolution_time_valid_n =
      sum(!is.na(resolution_days)),
    
    resolution_days_mean =
      mean_or_na(resolution_days),
    
    resolution_days_median =
      median_or_na(resolution_days),
    
    resolution_days_p75 =
      quantile_or_na(resolution_days, 0.75),
    
    resolution_days_p90 =
      quantile_or_na(resolution_days, 0.90),
    
    resolution_days_missing_n =
      sum(is.na(resolution_days)),
    
    .groups = "drop"
  ) %>%
  left_join(
    category_time_baseline,
    by = "Customer_Service_Requested"
  ) %>%
  mutate(
    # -----------------------------------------------------
    # Ratios vs category-wide time baseline
    # -----------------------------------------------------
    response_mean_ratio_vs_category =
      safe_ratio(response_days_mean, category_response_days_mean),
    
    response_median_ratio_vs_category =
      safe_ratio(response_days_median, category_response_days_median),
    
    resolution_mean_ratio_vs_category =
      safe_ratio(resolution_days_mean, category_resolution_days_mean),
    
    resolution_median_ratio_vs_category =
      safe_ratio(resolution_days_median, category_resolution_days_median),
    
    response_mean_ratio_vs_category_round =
      round(response_mean_ratio_vs_category, 2),
    
    response_median_ratio_vs_category_round =
      round(response_median_ratio_vs_category, 2),
    
    resolution_mean_ratio_vs_category_round =
      round(resolution_mean_ratio_vs_category, 2),
    
    resolution_median_ratio_vs_category_round =
      round(resolution_median_ratio_vs_category, 2),
    
    # -----------------------------------------------------
    # Delay levels
    # Main interpretation should use median ratio.
    # Mean ratio is useful for backlog / long-tail delays.
    # -----------------------------------------------------
    response_median_delay_level =
      get_delay_level(
        response_median_ratio_vs_category,
        response_time_valid_n
      ),
    
    response_mean_delay_level =
      get_delay_level(
        response_mean_ratio_vs_category,
        response_time_valid_n
      ),
    
    resolution_median_delay_level =
      get_delay_level(
        resolution_median_ratio_vs_category,
        resolution_time_valid_n
      ),
    
    resolution_mean_delay_level =
      get_delay_level(
        resolution_mean_ratio_vs_category,
        resolution_time_valid_n
      ),
    
    # -----------------------------------------------------
    # Long-tail flags:
    # mean is high but median is not high.
    # -----------------------------------------------------
    response_long_tail_delay_flag =
      response_mean_ratio_vs_category >= slower_threshold &
      response_median_ratio_vs_category < moderately_slower_threshold,
    
    resolution_long_tail_delay_flag =
      resolution_mean_ratio_vs_category >= slower_threshold &
      resolution_median_ratio_vs_category < moderately_slower_threshold,
    
    response_typical_delay_flag =
      response_median_ratio_vs_category >= slower_threshold,
    
    resolution_typical_delay_flag =
      resolution_median_ratio_vs_category >= slower_threshold,
    
    response_moderate_typical_delay_flag =
      response_median_ratio_vs_category >= moderately_slower_threshold,
    
    resolution_moderate_typical_delay_flag =
      resolution_median_ratio_vs_category >= moderately_slower_threshold,
    
    # Rounded time values
    response_days_mean_round = round(response_days_mean, 2),
    response_days_median_round = round(response_days_median, 2),
    response_days_p75_round = round(response_days_p75, 2),
    response_days_p90_round = round(response_days_p90, 2),
    
    resolution_days_mean_round = round(resolution_days_mean, 2),
    resolution_days_median_round = round(resolution_days_median, 2),
    resolution_days_p75_round = round(resolution_days_p75, 2),
    resolution_days_p90_round = round(resolution_days_p90, 2)
  )


