    category_resolution_days_median_round,
    category_resolution_days_p75,
    category_resolution_days_p75_round,
    category_resolution_days_p90,
    category_resolution_days_p90_round,
    
    # -----------------------------------------------------
    # Category x SCREEN response/resolution time
