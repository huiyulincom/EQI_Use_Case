# =========================================================
# 22. Category x SCREEN total charts
#
# Chart 1:
# Delay chart with overall response/resolution baselines.
#
# Chart 2:
# Overrepresentation ratio chart.
#
# Row = CSR category x EQI SCREEN
# =========================================================

output_08_category_screen_delay_chart_data <- file.path(
  output_folder,
  "08_category_screen_delay_chart_data.csv"
)

output_09_category_screen_overrep_chart_data <- file.path(
  output_folder,
  "09_category_screen_overrepresentation_chart_data.csv"
)

# Number of category x SCREEN combinations shown in each chart
top_n_category_screen_for_delay_bar <- 60
top_n_category_screen_for_overrep_bar <- 60


# ---------------------------------------------------------
# 22A. Prepare shared category x SCREEN chart data
# ---------------------------------------------------------

category_screen_chart_data <- client_base_category_screen_summary %>%
  filter(
    observed_case_count > 0
  ) %>%
  mutate(
    category_screen_label = paste0(
      Customer_Service_Requested,
      " | SCREEN ",
      SCREEN,
      " | n=",
      observed_case_count
    ),
    
    priority_rank = case_when(
      priority_review_group == "High priority: elevated representation + slower resolution" ~ 1,
      priority_review_group == "Priority review: elevated representation + moderate resolution delay" ~ 2,
      priority_review_group == "Backlog review: elevated representation + long-tail resolution delay" ~ 3,
      priority_review_group == "Elevated representation" ~ 4,
      priority_review_group == "Moderately elevated representation" ~ 5,
      priority_review_group == "Resolution delay review" ~ 6,
      priority_review_group == "Resolution backlog review" ~ 7,
      TRUE ~ 8
    ),
    
    sort_overrep_ratio = if_else(
      is.na(observed_expected_ratio_by_all_csr_population_round),
      -Inf,
      observed_expected_ratio_by_all_csr_population_round
    ),
    
    sort_resolution_ratio = if_else(
      is.na(resolution_median_ratio_vs_category_round),
      -Inf,
      resolution_median_ratio_vs_category_round
    )
  )


# =========================================================
# 23. Fig 04:
# Category x SCREEN delay chart with OVERALL baseline
#
# Bars = category x SCREEN average / median days
# Lines = overall CSR average / median
# =========================================================

category_screen_delay_chart_data <- category_screen_chart_data %>%
  select(
    Customer_Service_Requested,
    SCREEN,
    category_screen_label,
    
    observed_case_count,
    total_cases_in_category,
    priority_review_group,
    priority_rank,
    
    population_representation_level,
    observed_expected_ratio_by_all_csr_population_round,
    
    response_time_valid_n,
    response_days_average_round,
    response_days_median_round,
    
    resolution_time_valid_n,
    resolution_days_average_round,
    resolution_days_median_round,
    
    response_average_ratio_vs_category_round,
    response_median_ratio_vs_category_round,
    
    resolution_average_ratio_vs_category_round,
    resolution_median_ratio_vs_category_round,
    resolution_median_delay_level,
    
    sort_overrep_ratio,
    sort_resolution_ratio
  ) %>%
  filter(
    observed_case_count >= min_case_count
  ) %>%
  arrange(
    priority_rank,
    desc(sort_overrep_ratio),
    desc(sort_resolution_ratio),
    desc(observed_case_count)
  ) %>%
  slice_head(n = top_n_category_screen_for_delay_bar)

safe_write_csv(
  category_screen_delay_chart_data,
  output_08_category_screen_delay_chart_data
)

# Important:
# For ggplot horizontal bars, factor levels appear from bottom to top.
# Use rev() so the highest priority rows appear at the top.
delay_category_screen_order <- rev(
  category_screen_delay_chart_data$category_screen_label
)

category_screen_delay_chart_data <- category_screen_delay_chart_data %>%
  mutate(
    category_screen_label = factor(
      category_screen_label,
      levels = delay_category_screen_order
    )
  )

screen_delay_long <- category_screen_delay_chart_data %>%
  select(
    category_screen_label,
    Customer_Service_Requested,
    SCREEN,
    observed_case_count,
    
    response_days_average_round,
    response_days_median_round,
    resolution_days_average_round,
    resolution_days_median_round
  ) %>%
  pivot_longer(
    cols = c(
      response_days_average_round,
      response_days_median_round,
      resolution_days_average_round,
      resolution_days_median_round
    ),
    names_to = "metric",
    values_to = "days"
  ) %>%
  mutate(
    time_type = case_when(
      metric %in% c(
        "response_days_average_round",
        "response_days_median_round"
      ) ~ "Response",
      
      metric %in% c(
        "resolution_days_average_round",
        "resolution_days_median_round"
      ) ~ "Resolution",
      
      TRUE ~ "Other"
    ),
    
    statistic = case_when(
      metric %in% c(
        "response_days_average_round",
        "resolution_days_average_round"
      ) ~ "SCREEN average",
      
      metric %in% c(
        "response_days_median_round",
        "resolution_days_median_round"
      ) ~ "SCREEN median",
      
      TRUE ~ metric
    ),
    
    time_type = factor(
      time_type,
      levels = c("Response", "Resolution")
    ),
    
    statistic = factor(
      statistic,
      levels = c(
        "SCREEN average",
        "SCREEN median"
      )
    )
  ) %>%
  filter(!is.na(days))


# Overall baseline values
overall_response_average <- overall_delay_summary$response_days_average_round[1]
overall_response_median  <- overall_delay_summary$response_days_median_round[1]

overall_resolution_average <- overall_delay_summary$resolution_days_average_round[1]
overall_resolution_median  <- overall_delay_summary$resolution_days_median_round[1]

overall_baseline_line_df <- tibble::tibble(
  time_type = c(
    "Response",
    "Response",
    "Resolution",
    "Resolution"
  ),
  
  overall_metric = c(
    "Overall average",
    "Overall median",
    "Overall average",
    "Overall median"
  ),
  
  overall_days = c(
    overall_response_average,
    overall_response_median,
    overall_resolution_average,
    overall_resolution_median
  )
) %>%
  mutate(
    time_type = factor(
      time_type,
      levels = c("Response", "Resolution")
    ),
    
    overall_metric = factor(
      overall_metric,
      levels = c(
        "Overall average",
        "Overall median"
      )
    )
  ) %>%
  filter(!is.na(overall_days))


category_screen_delay_chart_height <- max(
  12,
  length(unique(screen_delay_long$category_screen_label)) * 0.30
)

p_category_screen_delay_overall_baseline <- ggplot(
  screen_delay_long,
  aes(
    x = days,
    y = category_screen_label,
    fill = statistic
  )
) +
  geom_col(
    position = position_dodge(width = 0.75),
    width = 0.7
  ) +
  geom_vline(
    data = overall_baseline_line_df,
    aes(
      xintercept = overall_days,
      linetype = overall_metric
    ),
    linewidth = 0.8
  ) +
  facet_wrap(
    ~ time_type,
    scales = "free_x"
  ) +
  labs(
    title = "Response and Resolution Days by CSR Category x EQI SCREEN",
    subtitle = "Sorted by priority group, overrepresentation ratio, resolution delay ratio, and case count. Vertical lines show overall CSR average and median baselines.",
    x = "Days",
    y = "CSR Category x EQI SCREEN",
    fill = "SCREEN metric",
    linetype = "Overall baseline"
  ) +
  theme_minimal() +
  theme(
    panel.grid.major.y = element_blank(),
    legend.position = "bottom"
  )

ggsave(
  filename = file.path(
    figure_folder,
    "fig_04_category_screen_delay_all_metrics_with_overall_baseline_sorted.png"
  ),
  plot = p_category_screen_delay_overall_baseline,
  width = 15,
  height = category_screen_delay_chart_height,
  dpi = 300
)


# =========================================================
# 24. Fig 05:
# Category x SCREEN overrepresentation ratio chart
#
# Bar = observed / expected ratio
# Baseline = 1.0
#
# Threshold lines:
# 1.25 = moderately elevated
# 1.50 = elevated
# 2.00 = strongly elevated
# =========================================================

category_screen_overrep_chart_data <- category_screen_chart_data %>%
  filter(
    observed_case_count >= min_case_count,
    !is.na(observed_expected_ratio_by_all_csr_population_round)
  ) %>%
  mutate(
    overrep_level_for_plot = case_when(
      population_representation_level == "Below expected" ~ "Below expected",
      population_representation_level == "Close to expected" ~ "Close to expected",
      population_representation_level == "Moderately elevated" ~ "Moderately elevated",
      population_representation_level == "Elevated" ~ "Elevated",
      population_representation_level == "Strongly elevated" ~ "Strongly elevated",
      population_representation_level == "Low case count" ~ "Low case count",
      TRUE ~ "Other / missing"
    ),
    
    overrep_level_for_plot = factor(
      overrep_level_for_plot,
      levels = c(
        "Below expected",
        "Close to expected",
        "Moderately elevated",
        "Elevated",
        "Strongly elevated",
        "Low case count",
        "Other / missing"
      )
    )
  ) %>%
  select(
    Customer_Service_Requested,
    SCREEN,
    category_screen_label,
    
    observed_case_count,
    total_cases_in_category,
    priority_review_group,
    priority_rank,
    
    population_representation_level,
    overrep_level_for_plot,
    
    expected_cases_by_all_csr_population_round,
    observed_expected_ratio_by_all_csr_population_round,
    excess_cases_by_all_csr_population_round,
    
    resolution_median_ratio_vs_category_round,
    resolution_median_delay_level,
    
    sort_overrep_ratio,
    sort_resolution_ratio
  ) %>%
  arrange(
    priority_rank,
    desc(sort_overrep_ratio),
    desc(sort_resolution_ratio),
    desc(observed_case_count)
  ) %>%
  slice_head(n = top_n_category_screen_for_overrep_bar)

safe_write_csv(
  category_screen_overrep_chart_data,
  output_09_category_screen_overrep_chart_data
)

# Again, reverse levels so highest priority rows are on top.
overrep_category_screen_order <- rev(
  category_screen_overrep_chart_data$category_screen_label
)

category_screen_overrep_chart_data <- category_screen_overrep_chart_data %>%
  mutate(
    category_screen_label = factor(
      category_screen_label,
      levels = overrep_category_screen_order
    ),
    
    ratio_label = if_else(
      is.na(observed_expected_ratio_by_all_csr_population_round),
      "",
      sprintf("%.2f", observed_expected_ratio_by_all_csr_population_round)
    )
  )

overrep_chart_height <- max(
  12,
  length(unique(category_screen_overrep_chart_data$category_screen_label)) * 0.30
)

p_category_screen_overrep_ratio <- ggplot(
  category_screen_overrep_chart_data,
  aes(
    x = observed_expected_ratio_by_all_csr_population_round,
    y = category_screen_label,
    fill = overrep_level_for_plot
  )
) +
  geom_col(width = 0.7) +
  geom_vline(
    xintercept = 1,
    linetype = "solid",
    linewidth = 0.7
  ) +
  geom_vline(
    xintercept = 1.25,
    linetype = "dashed",
    linewidth = 0.6
  ) +
  geom_vline(
    xintercept = 1.5,
    linetype = "dashed",
    linewidth = 0.6
  ) +
  geom_vline(
    xintercept = 2,
    linetype = "dashed",
    linewidth = 0.6
  ) +
  geom_text(
    aes(label = ratio_label),
    hjust = -0.15,
    size = 3
  ) +
  scale_fill_manual(
    values = c(
      "Below expected" = "#2C7BB6",
      "Close to expected" = "#D9D9D9",
      "Moderately elevated" = "#FFFFBF",
      "Elevated" = "#FDAE61",
      "Strongly elevated" = "#D7191C",
      "Low case count" = "#F0F0F0",
      "Other / missing" = "white"
    ),
    drop = FALSE
  ) +
  labs(
    title = "Overrepresentation Ratio by CSR Category x EQI SCREEN",
    subtitle = "Bar shows observed-to-expected ratio. Baseline = population distribution of all CSR-matched EQI blocks.",
    x = "Observed-to-expected ratio",
    y = "CSR Category x EQI SCREEN",
    fill = "Representation level"
  ) +
  theme_minimal() +
  theme(
    panel.grid.major.y = element_blank(),
    legend.position = "bottom"
  ) +
  coord_cartesian(
    xlim = c(
      0,
      max(
        category_screen_overrep_chart_data$observed_expected_ratio_by_all_csr_population_round,
        na.rm = TRUE
      ) * 1.15
    )
  )

ggsave(
  filename = file.path(
    figure_folder,
    "fig_05_category_screen_overrepresentation_ratio_sorted.png"
  ),
  plot = p_category_screen_overrep_ratio,
  width = 15,
  height = overrep_chart_height,
  dpi = 300
)
