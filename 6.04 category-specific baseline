library(sf)
library(dplyr)
library(stringr)
library(readr)
library(tidyr)

# =========================================================
# 1. User inputs
# =========================================================

gdb_path_points <- "C:/Users/s160418/OneDrive - California Department of Transportation/Desktop/ESTA/EQI Use Case/Maintenance/Maintenance_CSR/Maintenance_CSR.gdb"
layer_points    <- "CSR_02_23_2026_Projected"

gdb_path_eqi <- "C:/Users/s160418/OneDrive - California Department of Transportation/Desktop/ESTA/EQI Use Case/Maintenance/Maintenance_CSR/Maintenance_CSR.gdb"
layer_eqi    <- "EQI_Shapefile_ExportFeatures"

field_request <- "Customer_Service_Requested"
field_screen  <- "SCREEN"
field_pop     <- "POP20"

# Optional: if EQI polygon layer already has a stable unique ID field, use it here
eqi_id_field <- NULL
# eqi_id_field <- "OBJECTID"

# Use a short local folder to avoid OneDrive writing issues
output_folder <- "C:/Users/s160418/Desktop/CSR_Category_Specific_Baseline_Output"

if (!dir.exists(output_folder)) {
  dir.create(output_folder, recursive = TRUE)
}

output_category_baseline_csv <- file.path(
  output_folder,
  "01_category_specific_baseline.csv"
)

output_observed_expected_csv <- file.path(
  output_folder,
  "02_category_specific_observed_expected.csv"
)

output_overrepresented_csv <- file.path(
  output_folder,
  "03_category_specific_overrepresented_only.csv"
)

output_top_screen_csv <- file.path(
  output_folder,
  "04_category_specific_top_screen_summary.csv"
)

# Thresholds
min_case_count <- 10
overrepresented_ratio_threshold <- 1.5
underrepresented_ratio_threshold <- 0.67


# =========================================================
# 2. Safe CSV writer
# =========================================================

safe_write_csv <- function(df, path) {
  
  cat("\nPreparing to write:\n", path, "\n")
  cat("Rows:", nrow(df), " Columns:", ncol(df), "\n")
  
  df <- as.data.frame(df)
  
  if ("geometry" %in% names(df)) {
    df$geometry <- NULL
  }
  
  list_cols <- names(df)[sapply(df, is.list)]
  if (length(list_cols) > 0) {
    for (col in list_cols) {
      df[[col]] <- as.character(df[[col]])
    }
  }
  
  numeric_cols <- names(df)[sapply(df, is.numeric)]
  if (length(numeric_cols) > 0) {
    for (col in numeric_cols) {
      df[[col]][is.infinite(df[[col]]) | is.nan(df[[col]])] <- NA_real_
    }
  }
  
  if (file.exists(path)) {
    file.remove(path)
  }
  
  if (requireNamespace("data.table", quietly = TRUE)) {
    data.table::fwrite(
      df,
      file = path,
      na = ""
    )
  } else {
    utils::write.csv(
      df,
      file = path,
      row.names = FALSE,
      na = ""
    )
  }
  
  cat("Finished writing:\n", path, "\n")
}


# =========================================================
# 3. Read data
# =========================================================

cat("\nReading point layer...\n")
points_sf <- st_read(gdb_path_points, layer = layer_points, quiet = FALSE)

cat("\nReading EQI polygon layer...\n")
eqi_sf <- st_read(gdb_path_eqi, layer = layer_eqi, quiet = FALSE)


# =========================================================
# 4. Check required fields
# =========================================================

if (!(field_request %in% names(points_sf))) {
  stop(
    paste0(
      "Field '", field_request, "' was not found in point layer.\n",
      "Available fields:\n",
      paste(names(points_sf), collapse = ", ")
    )
  )
}

if (!(field_screen %in% names(eqi_sf))) {
  stop(
    paste0(
      "Field '", field_screen, "' was not found in EQI layer.\n",
      "Available fields:\n",
      paste(names(eqi_sf), collapse = ", ")
    )
  )
}

if (!(field_pop %in% names(eqi_sf))) {
  stop(
    paste0(
      "Field '", field_pop, "' was not found in EQI layer.\n",
      "Available fields:\n",
      paste(names(eqi_sf), collapse = ", ")
    )
  )
}


# =========================================================
# 5. Match CRS
# =========================================================

if (st_crs(points_sf) != st_crs(eqi_sf)) {
  eqi_sf <- st_transform(eqi_sf, st_crs(points_sf))
}


# =========================================================
# 6. Create unique EQI polygon ID
# =========================================================

if (!is.null(eqi_id_field)) {
  
  if (!(eqi_id_field %in% names(eqi_sf))) {
    stop(
      paste0(
        "eqi_id_field '", eqi_id_field, "' was not found in EQI layer."
      )
    )
  }
  
  eqi_sf <- eqi_sf %>%
    mutate(eqi_poly_id = as.character(.data[[eqi_id_field]]))
  
} else {
  
  eqi_sf <- eqi_sf %>%
    mutate(eqi_poly_id = as.character(row_number()))
}


# =========================================================
# 7. Clean attributes
# =========================================================

points_clean <- points_sf %>%
  select(all_of(field_request)) %>%
  mutate(
    Customer_Service_Requested = as.character(.data[[field_request]]),
    Customer_Service_Requested = str_squish(Customer_Service_Requested),
    Customer_Service_Requested = na_if(Customer_Service_Requested, ""),
    Customer_Service_Requested = if_else(
      is.na(Customer_Service_Requested),
      "NA / Blank",
      Customer_Service_Requested
    )
  )

eqi_clean <- eqi_sf %>%
  select(eqi_poly_id, all_of(field_screen), all_of(field_pop)) %>%
  mutate(
    SCREEN = as.character(.data[[field_screen]]),
    SCREEN = str_squish(SCREEN),
    SCREEN = na_if(SCREEN, ""),
    SCREEN = if_else(
      is.na(SCREEN),
      "NA / Blank",
      SCREEN
    ),
    POP20 = suppressWarnings(as.numeric(.data[[field_pop]])),
    POP20 = if_else(is.na(POP20), 0, POP20)
  )


# =========================================================
# 8. Spatial join
#    Assign each CSR point to an EQI polygon
# =========================================================

cat("\nRunning spatial join...\n")

joined_sf <- st_join(points_clean, eqi_clean, left = TRUE)

joined_df <- joined_sf %>%
  st_drop_geometry() %>%
  mutate(
    SCREEN = if_else(
      is.na(SCREEN),
      "Outside polygon / No match",
      SCREEN
    ),
    eqi_poly_id = if_else(
      is.na(eqi_poly_id),
      "No_match",
      eqi_poly_id
    ),
    POP20 = if_else(
      is.na(POP20),
      0,
      POP20
    )
  )

cat("\nSpatial join finished.\n")
cat("Joined rows:", nrow(joined_df), "\n")


# =========================================================
# 9. Keep only matched CSR records
# =========================================================

matched_df <- joined_df %>%
  filter(
    !is.na(Customer_Service_Requested),
    !is.na(SCREEN),
    eqi_poly_id != "No_match",
    SCREEN != "Outside polygon / No match"
  )

cat("\nMatched CSR records:", nrow(matched_df), "\n")


# =========================================================
# 10. Category-specific baseline
#
# For each category, first identify the unique EQI polygons
# where this category appeared.
#
# Then calculate the SCREEN distribution of those polygons.
#
# This is the category-specific baseline.
# =========================================================

category_specific_blocks <- matched_df %>%
  distinct(
    Customer_Service_Requested,
    eqi_poly_id,
    SCREEN,
    POP20
  )

category_specific_baseline <- category_specific_blocks %>%
  group_by(Customer_Service_Requested, SCREEN) %>%
  summarise(
    category_screen_block_count = n_distinct(eqi_poly_id),
    category_screen_population = sum(POP20, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  group_by(Customer_Service_Requested) %>%
  mutate(
    category_total_matched_block_count =
      sum(category_screen_block_count, na.rm = TRUE),
    
    category_total_matched_population =
      sum(category_screen_population, na.rm = TRUE),
    
    category_screen_block_share =
      category_screen_block_count / category_total_matched_block_count,
    
    category_screen_population_share =
      if_else(
        category_total_matched_population > 0,
        category_screen_population / category_total_matched_population,
        NA_real_
      ),
    
    category_screen_block_share_label =
      paste0(round(category_screen_block_share * 100, 2), "%"),
    
    category_screen_population_share_label =
      paste0(round(category_screen_population_share * 100, 2), "%")
  ) %>%
  ungroup() %>%
  arrange(
    Customer_Service_Requested,
    SCREEN
  )


# =========================================================
# 11. Observed cases by category x SCREEN
# =========================================================

observed_category_screen_raw <- matched_df %>%
  count(
    Customer_Service_Requested,
    SCREEN,
    name = "observed_case_count"
  )

# Make complete category x SCREEN table within each category baseline.
# This keeps SCREEN groups that are in the category baseline.
observed_category_screen <- category_specific_baseline %>%
  select(
    Customer_Service_Requested,
    SCREEN
  ) %>%
  left_join(
    observed_category_screen_raw,
    by = c("Customer_Service_Requested", "SCREEN")
  ) %>%
  mutate(
    observed_case_count = replace_na(observed_case_count, 0L)
  ) %>%
  group_by(Customer_Service_Requested) %>%
  mutate(
    total_cases_in_category = sum(observed_case_count),
    
    observed_case_share_within_category =
      if_else(
        total_cases_in_category > 0,
        observed_case_count / total_cases_in_category,
        NA_real_
      ),
    
    observed_case_share_within_category_label =
      paste0(round(observed_case_share_within_category * 100, 2), "%")
  ) %>%
  ungroup()


# =========================================================
# 12. Observed vs expected using category-specific baseline
#
# Expected cases by block count:
# If cases in this category were evenly distributed according to
# the category's own matched-block distribution, how many cases
# would each SCREEN group have?
#
# Expected cases by population:
# If cases in this category were distributed according to the
# population of the category's matched blocks, how many cases
# would each SCREEN group have?
# =========================================================

category_specific_observed_expected <- observed_category_screen %>%
  left_join(
    category_specific_baseline,
    by = c("Customer_Service_Requested", "SCREEN")
  ) %>%
  mutate(
    # -----------------------------------------------------
    # Expected cases by category-specific block baseline
    # -----------------------------------------------------
    expected_cases_by_category_block_count =
      total_cases_in_category * category_screen_block_share,
    
    observed_expected_ratio_by_category_block_count =
      if_else(
        expected_cases_by_category_block_count > 0,
        observed_case_count / expected_cases_by_category_block_count,
        NA_real_
      ),
    
    excess_cases_by_category_block_count =
      observed_case_count - expected_cases_by_category_block_count,
    
    # -----------------------------------------------------
    # Expected cases by category-specific population baseline
    # -----------------------------------------------------
    expected_cases_by_category_population =
      total_cases_in_category * category_screen_population_share,
    
    observed_expected_ratio_by_category_population =
      if_else(
        expected_cases_by_category_population > 0,
        observed_case_count / expected_cases_by_category_population,
        NA_real_
      ),
    
    excess_cases_by_category_population =
      observed_case_count - expected_cases_by_category_population,
    
    # -----------------------------------------------------
    # Rounded columns
    # -----------------------------------------------------
    expected_cases_by_category_block_count_round =
      round(expected_cases_by_category_block_count, 2),
    
    expected_cases_by_category_population_round =
      round(expected_cases_by_category_population, 2),
    
    excess_cases_by_category_block_count_round =
      round(excess_cases_by_category_block_count, 2),
    
    excess_cases_by_category_population_round =
      round(excess_cases_by_category_population, 2),
    
    observed_expected_ratio_by_category_block_count_round =
      round(observed_expected_ratio_by_category_block_count, 2),
    
    observed_expected_ratio_by_category_population_round =
      round(observed_expected_ratio_by_category_population, 2),
    
    # -----------------------------------------------------
    # Interpretation flags
    # -----------------------------------------------------
    overrepresented_by_category_block_count = if_else(
      observed_case_count >= min_case_count &
        !is.na(observed_expected_ratio_by_category_block_count) &
        observed_expected_ratio_by_category_block_count >= overrepresented_ratio_threshold,
      TRUE,
      FALSE
    ),
    
    overrepresented_by_category_population = if_else(
      observed_case_count >= min_case_count &
        !is.na(observed_expected_ratio_by_category_population) &
        observed_expected_ratio_by_category_population >= overrepresented_ratio_threshold,
      TRUE,
      FALSE
    ),
    
    underrepresented_by_category_block_count = if_else(
      observed_case_count >= min_case_count &
        !is.na(observed_expected_ratio_by_category_block_count) &
        observed_expected_ratio_by_category_block_count <= underrepresented_ratio_threshold,
      TRUE,
      FALSE
    ),
    
    underrepresented_by_category_population = if_else(
      observed_case_count >= min_case_count &
        !is.na(observed_expected_ratio_by_category_population) &
        observed_expected_ratio_by_category_population <= underrepresented_ratio_threshold,
      TRUE,
      FALSE
    ),
    
    strongly_overrepresented_category_specific = if_else(
      overrepresented_by_category_block_count == TRUE &
        overrepresented_by_category_population == TRUE,
      TRUE,
      FALSE
    ),
    
    strongly_underrepresented_category_specific = if_else(
      underrepresented_by_category_block_count == TRUE &
        underrepresented_by_category_population == TRUE,
      TRUE,
      FALSE
    )
  ) %>%
  select(
    Customer_Service_Requested,
    SCREEN,
    
    observed_case_count,
    total_cases_in_category,
    observed_case_share_within_category,
    observed_case_share_within_category_label,
    
    category_screen_block_count,
    category_total_matched_block_count,
    category_screen_block_share,
    category_screen_block_share_label,
    expected_cases_by_category_block_count,
    expected_cases_by_category_block_count_round,
    excess_cases_by_category_block_count,
    excess_cases_by_category_block_count_round,
    observed_expected_ratio_by_category_block_count,
    observed_expected_ratio_by_category_block_count_round,
    
    category_screen_population,
    category_total_matched_population,
    category_screen_population_share,
    category_screen_population_share_label,
    expected_cases_by_category_population,
    expected_cases_by_category_population_round,
    excess_cases_by_category_population,
    excess_cases_by_category_population_round,
    observed_expected_ratio_by_category_population,
    observed_expected_ratio_by_category_population_round,
    
    overrepresented_by_category_block_count,
    overrepresented_by_category_population,
    underrepresented_by_category_block_count,
    underrepresented_by_category_population,
    strongly_overrepresented_category_specific,
    strongly_underrepresented_category_specific
  ) %>%
  arrange(
    desc(strongly_overrepresented_category_specific),
    desc(observed_expected_ratio_by_category_population),
    desc(observed_expected_ratio_by_category_block_count),
    desc(observed_case_count)
  )


# =========================================================
# 13. Overrepresented-only table
# =========================================================

category_specific_overrepresented_only <- category_specific_observed_expected %>%
  filter(
    observed_case_count >= min_case_count
  ) %>%
  filter(
    observed_expected_ratio_by_category_population >= overrepresented_ratio_threshold |
      observed_expected_ratio_by_category_block_count >= overrepresented_ratio_threshold
  ) %>%
  arrange(
    desc(strongly_overrepresented_category_specific),
    desc(observed_expected_ratio_by_category_population),
    desc(observed_expected_ratio_by_category_block_count),
    desc(observed_case_count)
  )


# =========================================================
# 14. Top SCREEN group per category
#
# Ranking uses category-specific population ratio first.
# If population ratio is missing, it falls back to block-count ratio.
# =========================================================

category_specific_top_screen_summary <- category_specific_observed_expected %>%
  filter(
    observed_case_count >= min_case_count
  ) %>%
  mutate(
    ranking_ratio = coalesce(
      observed_expected_ratio_by_category_population,
      observed_expected_ratio_by_category_block_count
    )
  ) %>%
  group_by(Customer_Service_Requested) %>%
  slice_max(
    order_by = ranking_ratio,
    n = 1,
    with_ties = FALSE
  ) %>%
  ungroup() %>%
  arrange(
    desc(strongly_overrepresented_category_specific),
    desc(ranking_ratio),
    desc(observed_case_count)
  )


# =========================================================
# 15. Export outputs
# =========================================================

cat("\nExporting outputs...\n")

safe_write_csv(
  category_specific_baseline,
  output_category_baseline_csv
)

safe_write_csv(
  category_specific_observed_expected,
  output_observed_expected_csv
)

safe_write_csv(
  category_specific_overrepresented_only,
  output_overrepresented_csv
)

safe_write_csv(
  category_specific_top_screen_summary,
  output_top_screen_csv
)

cat("\nDone: category-specific baseline analysis.\n")

cat("\nOutputs saved to:\n")
cat(output_category_baseline_csv, "\n")
cat(output_observed_expected_csv, "\n")
cat(output_overrepresented_csv, "\n")
cat(output_top_screen_csv, "\n")

cat("\nOutput row counts:\n")
cat("01_category_specific_baseline:", nrow(category_specific_baseline), "\n")
cat("02_category_specific_observed_expected:", nrow(category_specific_observed_expected), "\n")
cat("03_category_specific_overrepresented_only:", nrow(category_specific_overrepresented_only), "\n")
cat("04_category_specific_top_screen_summary:", nrow(category_specific_top_screen_summary), "\n")
