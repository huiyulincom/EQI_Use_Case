)

output_overrepresented_only_csv <- file.path(
  output_folder_local,
  "csr_category_screen_overrepresented_only.csv"
)

cat("\nWriting summary table...\n")
readr::write_csv(
  category_screen_disproportionate_summary_clean,
  output_disproportionate_summary_csv
)
cat("Finished summary table:\n", output_disproportionate_summary_csv, "\n")

cat("\nWriting overrepresented-only table...\n")
readr::write_csv(
  category_screen_overrepresented_only,
  output_overrepresented_only_csv
)
cat("Finished overrepresented-only table:\n", output_overrepresented_only_csv, "\n")

cat("\nDone.\n")

