    response_days_average =
      mean_or_na(response_days),
    
    response_days_median =
      median_or_na(response_days),
    
    response_days_p75 =
      quantile_or_na(response_days, 0.75),
    
    response_days_p90 =
      quantile_or_na(response_days, 0.90),
    
    response_days_missing_n =
      sum(is.na(response_days)),
    
    # Resolution fields
    resolution_time_valid_n =
      sum(!is.na(resolution_days)),
    
    resolution_days_average =
      mean_or_na(resolution_days),
    
    resolution_days_median =
      median_or_na(resolution_days),
    
    resolution_days_p75 =
      quantile_or_na(resolution_days, 0.75),
    
    resolution_days_p90 =
      quantile_or_na(resolution_days, 0.90),
    
    resolution_days_missing_n =
      sum(is.na(resolution_days)),
    
    .groups = "drop"
  ) %>%
  left_join(
    category_time_baseline,
    by = "Customer_Service_Requested"
  ) %>%
  mutate(
    # Response ratios are descriptive only
    response_average_ratio_vs_category =
      safe_ratio(response_days_average, category_response_days_average),
    
    response_median_ratio_vs_category =
      safe_ratio(response_days_median, category_response_days_median),
    
    # Resolution ratios are used for prioritization
    resolution_average_ratio_vs_category =
      safe_ratio(resolution_days_average, category_resolution_days_average),
    
    resolution_median_ratio_vs_category =
      safe_ratio(resolution_days_median, category_resolution_days_median),
    
    response_average_ratio_vs_category_round =
      round(response_average_ratio_vs_category, 2),
    
    response_median_ratio_vs_category_round =
      round(response_median_ratio_vs_category, 2),
    
    resolution_average_ratio_vs_category_round =
      round(resolution_average_ratio_vs_category, 2),
    
    resolution_median_ratio_vs_category_round =
      round(resolution_median_ratio_vs_category, 2),
    
    response_median_delay_level =
      get_delay_level(
        response_median_ratio_vs_category,
        response_time_valid_n
      ),
    
    resolution_median_delay_level =
      get_delay_level(
        resolution_median_ratio_vs_category,
        resolution_time_valid_n
      ),
    
    resolution_average_delay_level =
      get_delay_level(
        resolution_average_ratio_vs_category,
        resolution_time_valid_n
      ),
    
    resolution_typical_delay_flag =
      resolution_median_ratio_vs_category >= slower_threshold,
    
    resolution_moderate_typical_delay_flag =
      resolution_median_ratio_vs_category >= moderately_slower_threshold,
    
    resolution_long_tail_delay_flag =
      resolution_average_ratio_vs_category >= slower_threshold &
      resolution_median_ratio_vs_category < moderately_slower_threshold,
    
    response_days_average_round =
      round(response_days_average, 2),
    
    response_days_median_round =
      round(response_days_median, 2),
    
    response_days_p75_round =
      round(response_days_p75, 2),
    
    response_days_p90_round =
      round(response_days_p90, 2),
    
    resolution_days_average_round =
      round(resolution_days_average, 2),
    
    resolution_days_median_round =
      round(resolution_days_median, 2),
    
    resolution_days_p75_round =
      round(resolution_days_p75, 2),
    
    resolution_days_p90_round =
      round(resolution_days_p90, 2),
    
    delay_interpretation = case_when(
      resolution_typical_delay_flag == TRUE ~
        "Typical resolution time is slower than this category's overall pattern.",
      
      resolution_long_tail_delay_flag == TRUE ~
